# Managed by tendcf; edits are overwritten on the next agent run.
[Unit]
Description=tendcf service {{id}}

[Service]
Type=simple
User={{run_as}}
WorkingDirectory={{working_dir}}
Restart={{unit.systemd.restart}}
ExecStart={{#command}}"{{{.}}}" {{/command}}

[Install]
WantedBy={{unit.systemd.wanted_by}}
