# tendcf's generic bundle (launchd on darwin, systemd on Linux).
#
# Reads $(data:variables.tendcf_service) / $(data:variables.tendcf_interlock)
# -- the data containers CFEngine's CMDB loader (LoadCMDBData/ReadCMDBVars in
# libpromises/cmdb.c) installs from $(sys.workdir)/data/host_specific.json's
# top-level "vars" key. Bare (unprefixed) CMDB keys default to namespace
# "data", scope "variables" (cmdb.c:GetCMDBVariableRef) -- confirmed against
# a real build, not assumed: an earlier draft of this file guessed the
# augments-loader's `def.*` scope, which is a DIFFERENT loader
# (LoadAugmentsData, used for def.json) that never runs on this file.
#
# host_specific.json is projector output and is policy-free: it only copies
# `state` verbatim per entry (goal-file-schema-reconciliation-2026-08-15.md,
# projector-reconciliation-2026-08-16.md C-1). Every decision below --
# present vs absent, whether an interlock's guard is met -- is this bundle's
# job, not the projector's.
#
# Interlocks are bundle-scoped refusal (architecture-DEFINITIVE-v3.md
# S7 / D16): an unmet interlock blocks every entry tagged with the same
# `bundle` name, not only the entries that reference the interlock
# directly. There is no literal per-service `bundle agent` -- nothing
# generates those -- so the scoping is reproduced with one guard class
# per distinct `bundle` tag (interlock_blocked_<tag>), computed once and
# checked by every entry carrying that tag.
#
# Two bundles, sequenced `tendcf_interlocks` then `tendcf_services`, and
# that order is load-bearing. CFEngine evaluates every `classes:` section
# of a bundle before any `commands:` section in each pass, and a class
# once defined is never undefined, so a verdict class computed in the same
# bundle as the pre_action command is fixed in pass 1 before the command
# has run (found 2026-10-29 with a real build: `interlock_blocked_demo`
# defined, THEN `/usr/bin/true` executed, THEN `interlock_ok_demo_check`
# set, refusal anyway). The commands therefore live in their own bundle
# with namespace-scoped outcome classes, and the services bundle reads a
# final verdict. Fail-closed is kept: a pre_action that never ran (dry-run
# `-n`, missing executable, timeout) leaves `interlock_ok_*` undefined and
# the bundle blocked.
#
# Entry ids and bundle tags are NOT valid CFEngine class-name fragments as
# written: the schema allows `.`/`-`/`@` (service ids can be a launchd
# label like "com.tendcf.caddy.main"; bundle tags are lowercase-kebab).
# CFEngine class names accept neither, confirmed against a real build
# ("Context string is invalid/out of range" on a raw hyphenated class).
# Every id/tag that becomes PART OF a class name goes through canonify()
# into its own variable first; raw ids are kept for data lookups and the
# rendered plist Label, where the real, uncanonified value is required.
#
# systemd adapter (linux-targets.md steps 4-5). Goal-file `unit.systemd`
# carries `enabled`, `restart` and `wanted_by`, all explicit:
#   - the unit is /etc/systemd/system/<id>, rendered from
#     templates/systemd.service.mustache (Type=simple; Restart= and
#     WantedBy= from the entry);
#   - every command argv element is double-quoted into ExecStart and
#     nothing is escaped: the goal-file schema holds a systemd entry's argv
#     and working_dir to an alphabet with no `"`, `\`, `$`, `%` or control
#     character, so a value systemd would re-read never reaches the
#     template (goal-file.schema.json, service_present allOf);
#   - run order per pass is files (render, or delete after teardown) then
#     commands: daemon-reload, enable/disable, start, restart, teardown,
#     reload after removal. State probes are snapshots (see the classes
#     section), so one run converges and the next does nothing.
#
# CMDB cross-check (`tendcf_cmdb`, proposal 2026-11-03 section 13, option 3,
# operator ruling Q10 2026-11-02). Everything above assumes CFEngine's loader
# installed what host_specific.json says. Nothing promises that for every
# engine: the fork before 2026-11-02 (`8f0076b81`, B-5b) skipped a bad entry on
# its own and still returned success, and a skipped `tendcf_interlock` leaves
# every service ungated (services are gated negatively, on
# `!interlock_blocked_*`, and that class only exists for an interlock that
# loaded). The fork at the pin (overlay/fork.json, PR #41, operator ruling R13)
# loads all-or-nothing instead: any invalid entry and it installs none of the
# file, so this check then sees every `vars` key missing and refuses. The two
# are independent: the check holds for a loader that fails closed, for one that
# does not, and for a gap in either. The check does not model WHY an entry was
# dropped. It reads the file itself and compares it with what the loader installed:
#   - the file's top-level keys must be exactly `vars`. The loader also applies
#     a `variables` section (loaded AFTER `vars`, replacing a same-named
#     variable) and a `classes` section (which can define `interlock_ok_*`);
#     the projector emits neither (N-2, bin/projector.py check_projection), so
#     any other top-level key is refused rather than compared;
#   - every key under `vars` must be a plain identifier ([A-Za-z0-9_]+). The
#     loader reads a key as a variable reference (cmdb.c GetCMDBVariableRef,
#     VarRefParse): `a.b` lands in scope a, `ns:b.c` in another namespace,
#     `a[i]` is an array element. Such a key can preset a variable of THIS
#     policy (`default:tendcf_services.service_ids`), so it is refused;
#   - for every key under `vars`, `data:variables.<key>` must exist;
#   - per key, the set of entry ids in the file must equal the set of
#     indices of the loaded container (a half-loaded container is caught);
#   - per key, the whole container the loader installed must equal the file's:
#     storejson() of `doc[vars][<key>]` against storejson() of
#     `data:variables.<key>`, string-equal (same parser and same bytes give the
#     same text, key order and number formatting included). A value that is not
#     an object is refused when it reads back differently: the loader installs
#     a scalar as a string (storejson() fails) and a list of primitives as an
#     slist of strings (numbers read back as strings; a list of strings reads
#     back equal and is accepted). Equal ids with changed values, as a
#     `variables` entry would give, are caught. A comparison that cannot be
#     computed is a problem of its own (`..._problem_uncomparable_<key>`, or
#     `..._problem_noverdict_<key>` when both texts exist but neither equality
#     nor a difference could be evaluated), not the absence of a difference;
#   - every `data:variables.*` the loader installed must be a key of `vars`
#     in the file;
#   - nothing the loader installed may lie outside `data:variables.<identifier>`:
#     no CMDB-installed variable of any other name, and no CMDB-installed class.
#     This is read from the loaded state (the variable table and the class
#     table, by the tag the loader puts on everything it installs,
#     `source=cmdb`), not from the file, in class expressions that call
#     variablesmatching() and classmatch() inline, so it names no variable that
#     a CMDB key could preset. It is what keeps the checker's own variables and
#     the gates' id lists out of reach (see "Presets" below). It also covers the
#     augments file (`def.json`, tag `source=augments_file`, loaded after the
#     CMDB): tendcf ships none, and a variable or class from one is refused
#     the same way (a host that needs a `def.json` must be given an exemption
#     here, deliberately);
#   - a file that exists but cannot be parsed (or exceeds the loader's own
#     5 MiB cap), and loaded data with no file at all, are mismatches.
# A missing file with nothing loaded is the normal empty case: no class, no
# report. A key the loader files elsewhere (`a.b`, `ns:b.c`) cannot match
# `data:variables.<key>`, so it reads as a mismatch: refused, never ignored.
# The data directory is `$(sys.workdir)/data` here; the loader uses
# GetDataDir() (CF_DATADIR, default <workdir>/data). A build with another data
# dir would compare against the wrong file and mostly fail closed.
#
# On any mismatch the single class `tendcf_cmdb_refused` is defined and
# NOTHING is actuated: no interlock pre_action, no service, no tombstone. The
# gate is one place per bundle: `interlock_ids` and `service_ids` are set to
# empty lists under the refusal, and every promise that acts iterates one of
# them. The two daemon-reload commands, which iterate no id, carry
# `!tendcf_cmdb_refused` themselves (a `classes` section could otherwise define
# their trigger classes; it is refused as well, but a refusal must not depend on
# that). A new actuating promise MUST iterate those ids or carry
# `!tendcf_cmdb_refused` itself. The mismatch is reported once, by
# tendcf_interlocks. Reports print file-derived text (keys, entry ids, section
# names) only after replacing every character outside [A-Za-z0-9._:@/-] with `?`
# and cutting it to a fixed length; the refusal summary and the foreign
# variable and class reports are static text.
#
# Presets. The loader installs a `vars` key under any name, so a key such as
# `default:tendcf_cmdb.doc` or `default:tendcf_services.interlock_ids` presets
# that variable before any policy runs. What a preset does then depends on the
# promise (verify_vars.c VerifyVarPromise, read at commit b8abf28408b1; the
# pin in overlay/fork.json is now d32cade13, which differs from it only in
# libpromises/cmdb.c, cmdb.h and tests): a promise with a LITERAL rvalue (`slist => { }`) always
# redefines it, so the policy's value stands. A promise whose rvalue is a
# FUNCTION CALL is skipped when the variable exists ("Already did this") if the
# call was not already evaluated to a value when the promise runs, and
# otherwise redefines it; which of the two happens is not something this policy
# relies on (tests/policy/run.sh check 9 saw both: some presets of the checker's
# and the gates' variables stayed, some were replaced by the policy's value).
# So the check does not try to make each variable immune: any variable the CMDB
# (or an augments file) installed under a name other than
# `data:variables.<identifier>` and still carrying the loader's tag when the
# classes are evaluated makes `tendcf_cmdb_problem_foreign_var`, read from the
# variable table, and a preset that was replaced is the policy's own value. The
# checker's `doc` is guarded to be read once, so a preset of it is never
# overwritten by a later pass and is refused by that class. Under the refusal
# the id lists are literal empty lists, which redefine a preset.
#
# Order and evaluation, as measured on the pinned fork (tests/policy/run.sh
# check 11, debug run of a real cf-agent, the replaced-file case): `tendcf_cmdb`
# was resolved 2 times, its vars `doc` promise was visited 1 time (skipped once
# `doc` exists), `file_json[..]` 10 times and the class `tendcf_cmdb_refused` 2
# times; the mutation script ran 1 time. So the vars are visited on every
# resolution, and a class is set once and never cleared, while a class that is
# still unset is evaluated again on the second resolution, from the same
# snapshot. The fork evaluates the vars and the classes of every
# `bundle common` before the vars of any other bundle, independently of
# `bundlesequence` (PolicyResolve and BundleResolve, libpromises/expand.c:846-871
# and 1145-1177), so `tendcf_cmdb_refused` is decided, on the first pass over
# the file, before the `!tendcf_cmdb_refused` on the agent bundles' `*_ids` is
# first read. A later vars pass that re-read the file would see a replacement
# the decision never compared, so `doc` is read ONCE: its promise is skipped
# once `doc` exists, every comparison input is derived from that one snapshot,
# and no later pass reads the file. The probe of check 11 replaces the file
# between the passes and shows that the loaded data are acted on and the
# replacement is not. Each problem class is defined from the current comparison,
# in positive form (a difference, an uncomputable side, a foreign variable),
# never as the negation of a class set once and never cleared: a promise for an
# already-set class is skipped (libpromises/promises.c), so "not equal" read
# from a sticky "equal" class would stay false after a later mismatch. The
# classes of the common bundle run in one pass in written order:
# `tendcf_cmdb_refused` comes after every `tendcf_cmdb_problem_*` class; do not
# reorder them. `tendcf_cmdb_json_same_<key>` (the two texts are equal) is read
# only by `..._problem_noverdict_<key>`, which refuses a comparison that gave
# neither "equal" nor "differs" (strcmp() is skipped when an argument still holds
# `$(`); it comes after the classes it reads and cannot hide a difference.
#
# One file on purpose: the fork resolves each file's bundles when it is loaded
# and the whole policy again afterwards (libpromises/loading.c), so `tendcf_cmdb`
# decides in the file it shares with the gated bundles, before their ids are
# first read. Were it split off, the literal empty `*_ids` lists under the
# refusal would still redefine the ids, so it would fail closed, but this is why
# the bundles live together.
#
# What is NOT guaranteed: the check compares the file with the loader's state at
# the evaluation. A file replaced after the last evaluation, or by a promise
# that changes `data:variables.*` afterwards, is not seen; and nothing here makes
# a publication atomic (`tendcf-install.sh data` installs by atomic rename, but
# the agent can still start between the loader's read and ours). Not a sandbox
# either: it is a consistency check between the file and what the loader
# installed. A CMDB author (root) already chooses each pre_action executable,
# `/bin/sh -c ...` included, and the unit commands, so it does not stop a hostile
# but self-consistent file; it stops a file and a loader that disagree, and the
# sections, keys, variables and classes through which a file could change what
# the policy reads without showing up as a `vars` difference.

bundle common tendcf_cmdb
{
  vars:
      "file"
        string => "$(sys.workdir)/data/host_specific.json";

      # 5242880 = the loader's HOST_SPECIFIC_DATA_MAX_SIZE (5 MiB). An absent
      # file leaves `doc` undefined and is not an error.
      #
      # Read ONCE (see "Order and evaluation"): the engine visits this promise on
      # every later pass, and a second read could return a file the classes never
      # compared. `not(isvariable("doc"))` skips it once `doc` exists, a preset
      # included (which is then refused as a foreign variable).
      "doc"
        data => readjson("$(file)", 5242880),
        ifvarclass => and(fileexists("$(file)"), not(isvariable("doc")));

      "file_keys"
        slist => getindices("doc[vars]"),
        ifvarclass => isvariable("doc[vars]");

      "file_keys"
        slist => { },
        ifvarclass => not(isvariable("doc[vars]"));

      # Top-level sections of the file. The loader applies `vars`, `variables`
      # and `classes` (cmdb.c LoadCMDBData); the projector emits only `vars`,
      # and anything else is refused (class `..._problem_sections`). A top-level
      # array reads as indices "0", "1", ... here and is refused the same way.
      "doc_sections"
        slist => getindices("doc"),
        ifvarclass => isvariable("doc");

      "doc_sections"
        slist => { },
        ifvarclass => not(isvariable("doc"));

      "allowed_sections"
        slist => { "vars" };

      "extra_sections"
        slist => difference("doc_sections", "allowed_sections");

      # Only a plain identifier is a `vars` key this policy will look up. The
      # grep() pattern is anchored by CFEngine. Every other key is refused as a
      # whole (`..._problem_badkey`) and is never used to build a variable name
      # below.
      "safe_keys"
        slist => grep("[A-Za-z0-9_]+", "file_keys");

      "bad_keys"
        slist => difference("file_keys", "safe_keys");

      "loaded_refs"
        slist => variablesmatching("^data:variables\..*");

      "loaded_keys"
        slist => maplist(regex_replace("$(this)", "^data:variables\.", "", ""),
                         "loaded_refs");

      "missing_keys"
        slist => difference("file_keys", "loaded_keys");

      "unlisted_keys"
        slist => difference("loaded_keys", "file_keys");

      # Printable forms for the reports: every character outside the safe set
      # becomes `?`, then each name is cut to 64 characters (two steps, each the
      # same maplist idiom as loaded_keys). Keys, ids and section names come
      # from the file and may hold newlines or escape sequences.
      "missing_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "missing_keys");
      "missing_clean"
        slist => maplist(string_head("$(this)", 64), "missing_san");

      "unlisted_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "unlisted_keys");
      "unlisted_clean"
        slist => maplist(string_head("$(this)", 64), "unlisted_san");

      "bad_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "bad_keys");
      "bad_clean"
        slist => maplist(string_head("$(this)", 64), "bad_san");

      "sections_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "extra_sections");
      "sections_clean"
        slist => maplist(string_head("$(this)", 64), "sections_san");

      "loaded_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "loaded_keys");
      "loaded_clean"
        slist => maplist(string_head("$(this)", 64), "loaded_san");

      "key_canon[$(safe_keys)]"
        string => canonify("$(safe_keys)");

      # The key as a report shows it: at most 64 characters (a safe key is a plain
      # identifier, so no character replacement is needed, but its length is not
      # bounded). Lookups and class names keep using the full `safe_keys`.
      "key_clean[$(safe_keys)]"
        string => string_head("$(safe_keys)", 64);

      "file_ids[$(safe_keys)]"
        slist => getindices("doc[vars][$(safe_keys)]");

      "loaded_ids[$(safe_keys)]"
        slist => getindices("data:variables.$(safe_keys)");

      "unloaded_ids[$(safe_keys)]"
        slist => difference("file_ids[$(safe_keys)]", "loaded_ids[$(safe_keys)]");

      "unfiled_ids[$(safe_keys)]"
        slist => difference("loaded_ids[$(safe_keys)]", "file_ids[$(safe_keys)]");

      "unloaded_san[$(safe_keys)]"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "unloaded_ids[$(safe_keys)]");

      "unloaded_clean[$(safe_keys)]"
        slist => maplist(string_head("$(this)", 64), "unloaded_san[$(safe_keys)]");

      "unloaded_joined[$(safe_keys)]"
        string => join(", ", "unloaded_clean[$(safe_keys)]");

      "unloaded_text[$(safe_keys)]"
        string => string_head("$(unloaded_joined[$(safe_keys)])", 400);

      "unfiled_san[$(safe_keys)]"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "unfiled_ids[$(safe_keys)]");

      "unfiled_clean[$(safe_keys)]"
        slist => maplist(string_head("$(this)", 64), "unfiled_san[$(safe_keys)]");

      "unfiled_joined[$(safe_keys)]"
        string => join(", ", "unfiled_clean[$(safe_keys)]");

      "unfiled_text[$(safe_keys)]"
        string => string_head("$(unfiled_joined[$(safe_keys)])", 400);

      # The whole container, as JSON text, from the file and as installed.
      # storejson() fails (the variable stays undefined) for anything that is
      # not a container or list, and for a name that is not defined; the
      # `uncomparable` class below makes an undefined side a problem.
      "file_json[$(safe_keys)]"
        string => storejson("doc[vars][$(safe_keys)]");

      "loaded_json[$(safe_keys)]"
        string => storejson("data:variables.$(safe_keys)");

  classes:
      "tendcf_cmdb_problem_unreadable"
        expression => and(fileexists("$(file)"),
                          not(isvariable("tendcf_cmdb.doc")));

      "tendcf_cmdb_problem_nofile"
        expression => and(not(fileexists("$(file)")),
                          isgreaterthan(length("loaded_keys"), 0));

      "tendcf_cmdb_problem_missing"
        expression => isgreaterthan(length("missing_keys"), 0);

      "tendcf_cmdb_problem_unlisted"
        expression => isgreaterthan(length("unlisted_keys"), 0);

      "tendcf_cmdb_problem_sections"
        expression => isgreaterthan(length("extra_sections"), 0);

      "tendcf_cmdb_problem_badkey"
        expression => isgreaterthan(length("bad_keys"), 0);

      # Read from the loaded state, with the calls inline: no variable here for
      # a CMDB key to preset. Every variable tagged by the CMDB loader or by the
      # augments loader is counted, and so is every one of them that is exactly
      # data:variables.<identifier> AND tagged by the CMDB loader; any excess is
      # a variable of another name (or from augments), which is a problem.
      "tendcf_cmdb_problem_foreign_var"
        expression => isgreaterthan(length(variablesmatching(".*", "source=cmdb", "source=augments_file")),
                                    length(variablesmatching("data:variables\.[A-Za-z0-9_]+", "source=cmdb")));

      "tendcf_cmdb_problem_foreign_class"
        expression => classmatch(".*", "source=cmdb", "source=augments_file");

      "tendcf_cmdb_problem_partial_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          or(isgreaterthan(length("unloaded_ids[$(safe_keys)]"), 0),
                             isgreaterthan(length("unfiled_ids[$(safe_keys)]"), 0)));

      # The two texts, computed now, differ. Defined only when both exist (an
      # undefined side leaves the strcmp() argument unexpanded and the
      # expression undefined; that case is the next class).
      "tendcf_cmdb_problem_differs_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          isvariable("file_json[$(safe_keys)]"),
                          isvariable("loaded_json[$(safe_keys)]"),
                          not(strcmp("$(file_json[$(safe_keys)])",
                                     "$(loaded_json[$(safe_keys)])")));

      # The two texts, computed now, are equal. Positive and set once, like every
      # class here, and it is read only by the no-verdict class below, so it can
      # only silence a no-verdict refusal; it never suppresses
      # `..._problem_differs_` or `..._problem_uncomparable_`, which do not read
      # it. The inputs are one snapshot (`doc` is read once, the loaded
      # containers do not change), so the comparison gives the same result on
      # every evaluation.
      "tendcf_cmdb_json_same_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          isvariable("file_json[$(safe_keys)]"),
                          isvariable("loaded_json[$(safe_keys)]"),
                          strcmp("$(file_json[$(safe_keys)])",
                                 "$(loaded_json[$(safe_keys)])"));

      # A loaded container for which one side could not be serialised. Needs only
      # isvariable(), whose arguments are literal names, so it cannot be
      # suppressed by an undefined variable.
      "tendcf_cmdb_problem_uncomparable_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          or(not(isvariable("file_json[$(safe_keys)]")),
                             not(isvariable("loaded_json[$(safe_keys)]"))));

      # Both containers serialised, and yet neither "equal" nor "differs" was
      # computed: strcmp() is skipped (the call fails, so the class stays
      # undefined) when an argument still holds `$(` or `${` after expansion,
      # which a file replaced after the loader's read can give (the loader itself
      # refuses `$(`, `${`, `@(`, `@{` in a key or a value). No verdict is not
      # agreement: refuse. Written after the two classes it reads.
      "tendcf_cmdb_problem_noverdict_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          isvariable("file_json[$(safe_keys)]"),
                          isvariable("loaded_json[$(safe_keys)]"),
                          not("tendcf_cmdb_json_same_$(key_canon[$(safe_keys)])"),
                          not("tendcf_cmdb_problem_differs_$(key_canon[$(safe_keys)])"));

      "tendcf_cmdb_refused"
        expression => classmatch("tendcf_cmdb_problem_.*");
}

bundle agent tendcf_interlocks
{
  vars:
      # Empty under a CMDB mismatch (see `tendcf_cmdb`): with no ids no
      # pre_action command is even built. Set explicitly, not left undefined:
      # a `vars` key such as "default:tendcf_interlocks.interlock_ids" would
      # have preset the list before the policy loaded, and a skipped promise
      # does not remove it.
      "interlock_ids"
        slist => getindices("data:variables.tendcf_interlock"),
        ifvarclass => "!tendcf_cmdb_refused";

      "interlock_ids"
        slist => { },
        ifvarclass => "tendcf_cmdb_refused";

      "interlock_canon[$(interlock_ids)]"
        string => canonify("$(interlock_ids)");

      # commands: promise runs <promiser> <arglist...>, and non-scalar
      # attributes (arglist, template_data below) can't take an indexed
      # data-container element directly -- CFEngine rejects "container
      # assigned to an indexed variable name" for that, and neither `@()`
      # nor bare `$()` accept a bracket path as a full non-scalar rvalue
      # (confirmed against a real build; both give parse errors, not just
      # a hunch). join() over the container path (a proven idiom: pass
      # the path as a plain string, CFEngine resolves it) sidesteps that.
      #
      # Guarantee, stated exactly: CFEngine starts no shell of its own for
      # this promise. tendcf_interlock_contain sets useshell => "noshell",
      # so cf-agent splits the joined string itself
      # (libpromises/exec_tools.c ArgSplitCommand: on whitespace, and an
      # argument that BEGINS with " ' or ` runs to the matching quote) and
      # execv()s the result: argv[0] is the program, the rest reach it
      # unchanged. `;`, `|`, `&&`, redirection and backticks mid-word are
      # plain arguments, never operators, and there is no PATH search.
      # That is NOT a sandbox: an author who declares ["/bin/sh", "-c", ...]
      # (schema-valid) still gets that shell, because the chosen program
      # interprets its own arguments. What is removed is the implicit
      # root shell over a joined string.
      #
      # The join is lossy for an element with whitespace, a leading quote or
      # an empty string, so the schema holds pre_action.command to an
      # alphabet with none of them (common.schema.json $defs/interlock_argv:
      # absolute command[0], then [A-Za-z0-9._+@:=,/-] only), pinned by
      # examples/broken/156-159, 161-174 and 176 (the services
      # contract_version by 160 and 175) and by tests/policy/run.sh check 8,
      # which records the argv a program receives. Remaining limit: nothing on
      # the device re-checks the schema. A projection that skipped it (the
      # projector only refuses `$(`, `${`, `@(`, `@{`; `tendcf-install.sh
      # data` installs without it) can carry a space or leading quote,
      # which shifts argv, or a relative command[0], which the guard on the
      # commands promise below refuses. Removing the join altogether (an
      # slist per interlock from getvalues(), passed as arglist) is
      # deliberately not done until proven against a real build.
      "pre_action_cmd[$(interlock_ids)]"
        string => join(" ",
          "data:variables.tendcf_interlock[$(interlock_ids)][pre_action][command]");

  commands:
      # pre_action: run the interlock's check under its own timeout, and
      # classify strictly by the entry's own expect_exit -- not bare
      # zero, since the schema allows any code 0-255.
      #
      # `if` fails closed on a relative command[0]: cf-agent would stat it
      # and execv() it against its own working directory (it is not a PATH
      # lookup), so the schema's absolute-path rule is re-enforced here for
      # a projection that skipped the schema (so a quoted absolute command[0],
      # "/bin/x", is refused too: the guard wants a leading `/`). A skipped promise leaves
      # interlock_ok_* undefined and the bundle blocked and reported.
      "$(pre_action_cmd[$(interlock_ids)])"
        if => regcmp("/.*", "$(pre_action_cmd[$(interlock_ids)])"),
        contain => tendcf_interlock_contain(
          "$(data:variables.tendcf_interlock[$(interlock_ids)][pre_action][timeout_seconds])"),
        classes => tendcf_interlock_result(
          "interlock_ok_$(interlock_canon[$(interlock_ids)])",
          "$(data:variables.tendcf_interlock[$(interlock_ids)][pre_action][expect_exit])");

  reports:
      # Why the promise above was skipped, so the blocked bundle's report
      # (tendcf_services, "not satisfied ... refused") has a cause beside it.
      # Best effort: inside the reports promise's ifelapsed window a second
      # agent run can suppress the line, while the refusal itself still holds
      # (it comes from interlock_ok_* staying undefined). The line is also
      # not printed when `command` is not an array or pre_action is missing
      # (the join then has no first element to test); the bare refusal line
      # still is.
      "tendcf: interlock '$(interlock_ids)' pre_action command[0] is not an absolute path; refused"
        if => not(regcmp("/.*", "$(pre_action_cmd[$(interlock_ids)])"));

      # The one report of a CMDB mismatch (tendcf_cmdb decides, this says).
      # First bundle of the sequence, so it comes before anything else.
      "tendcf_cmdb_refused"::
        "tendcf: CMDB cross-check failed: refusing to actuate anything (no interlock pre_action, no service, no tombstone) until $(tendcf_cmdb.file) and the data CFEngine loaded from it agree";

      "tendcf_cmdb_problem_unreadable"::
        "tendcf: CMDB cross-check: $(tendcf_cmdb.file) exists but cannot be read as JSON (parse error or larger than 5242880 bytes)";

      "tendcf_cmdb_problem_nofile"::
        "tendcf: CMDB cross-check: $(tendcf_cmdb.file) does not exist but CFEngine loaded data:variables.$(tendcf_cmdb.loaded_clean)";

      "tendcf_cmdb_problem_missing"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.missing_clean)' is under 'vars' in $(tendcf_cmdb.file) but CFEngine did not load data:variables.$(tendcf_cmdb.missing_clean) (the loader did not install it)";

      "tendcf_cmdb_problem_unlisted"::
        "tendcf: CMDB cross-check: CFEngine loaded data:variables.$(tendcf_cmdb.unlisted_clean), which is not a key under 'vars' in $(tendcf_cmdb.file)";

      "tendcf_cmdb_problem_partial_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' loaded differently from $(tendcf_cmdb.file): in the file only: [$(tendcf_cmdb.unloaded_text[$(tendcf_cmdb.safe_keys)])]; loaded only: [$(tendcf_cmdb.unfiled_text[$(tendcf_cmdb.safe_keys)])]";

      "tendcf_cmdb_problem_differs_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' content differs between $(tendcf_cmdb.file) and the data CFEngine loaded";

      "tendcf_cmdb_problem_uncomparable_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' content could not be compared between $(tendcf_cmdb.file) and the data CFEngine loaded (one side is not a container or list)";

      "tendcf_cmdb_problem_noverdict_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' content comparison reached no verdict between $(tendcf_cmdb.file) and the data CFEngine loaded (a text that cannot be evaluated, such as one holding a variable reference)";

      "tendcf_cmdb_problem_sections"::
        "tendcf: CMDB cross-check: $(tendcf_cmdb.file) has top-level section '$(tendcf_cmdb.sections_clean)' besides 'vars'; only 'vars' is accepted (the loader would also apply 'variables' and 'classes')";

      # Static text on purpose: the names are in `cf-promises --show-vars`
      # (tag source=cmdb or source=augments_file) and `--show-classes`.
      "tendcf_cmdb_problem_foreign_var"::
        "tendcf: CMDB cross-check: the CMDB or an augments file installed a variable outside data:variables.<identifier> (a preset of a variable of this policy or of another bundle); only data:variables.<identifier> is accepted";

      "tendcf_cmdb_problem_foreign_class"::
        "tendcf: CMDB cross-check: the CMDB or an augments file defined a class; no class from either is accepted";

      "tendcf_cmdb_problem_badkey"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.bad_clean)' under 'vars' in $(tendcf_cmdb.file) is not a plain identifier ([A-Za-z0-9_]+); the loader would read it as a variable reference";
}

bundle agent tendcf_services
{
  vars:
      # Empty under a CMDB mismatch, see tendcf_interlocks and `tendcf_cmdb`
      # (set explicitly for the same reason as there).
      "service_ids"
        slist => getindices("data:variables.tendcf_service"),
        ifvarclass => "!tendcf_cmdb_refused";

      "service_ids"
        slist => { },
        ifvarclass => "tendcf_cmdb_refused";

      "interlock_ids"
        slist => getindices("data:variables.tendcf_interlock"),
        ifvarclass => "!tendcf_cmdb_refused";

      "interlock_ids"
        slist => { },
        ifvarclass => "tendcf_cmdb_refused";

      "service_canon[$(service_ids)]"
        string => canonify("$(service_ids)");

      "interlock_canon[$(interlock_ids)]"
        string => canonify("$(interlock_ids)");

      "service_bundle_canon[$(service_ids)]"
        string => canonify(
          "$(data:variables.tendcf_service[$(service_ids)][bundle])");

      "interlock_bundle_canon[$(interlock_ids)]"
        string => canonify(
          "$(data:variables.tendcf_interlock[$(interlock_ids)][bundle])");

      # The goal file's `unit` carries exactly one flavour key (goal-file
      # schema $defs/unit, oneOf launchd/systemd/runit); a tombstone
      # ({"state": "absent"}) carries none, so this is "" for it.
      "unit_flavours[$(service_ids)]"
        slist => getindices("data:variables.tendcf_service[$(service_ids)][unit]");

      "unit_flavour[$(service_ids)]"
        string => join(",", "unit_flavours[$(service_ids)]");

  classes:
      # state dispatch -- the one place this bundle inspects an entry's
      # value to pick a promise, which C-1 says belongs here and nowhere
      # upstream of it.
      "service_$(service_canon[$(service_ids)])_present"
        expression => strcmp("$(data:variables.tendcf_service[$(service_ids)][state])",
                              "present");

      # Bundle-scoped blast radius: named by the interlock's OWN bundle
      # tag, not by which service references it, so N interlocks sharing
      # one tag OR together with no join against the service list.
      # interlock_ok_* is final here: tendcf_interlocks ran to completion
      # before this bundle started (see the header).
      "interlock_blocked_$(interlock_bundle_canon[$(interlock_ids)])"
        expression => "!interlock_ok_$(interlock_canon[$(interlock_ids)])";

      # Fail-closed flavour/host guard (linux-targets.md step 3). Two
      # adapters exist, each tied to the host that can run it: launchd on
      # darwin, systemd on a Linux host booted by systemd. A present entry
      # is actuated only when its flavour AND its host both match; anything
      # else is refused and reported, never rendered through the wrong
      # adapter (a systemd entry would otherwise become a LaunchDaemons
      # plist, and a launchd entry on Linux would be written to /Library
      # and handed to a launchctl that is not there). A later adapter adds
      # its own `service_*_supported` disjunct; nothing here is removed.
      #
      # "Booted by systemd" is sd_booted(3): /run/systemd/system is a
      # directory. A Linux container or chroot without it has a systemctl
      # binary that cannot reach a manager, so it counts as no host.
      "tendcf_systemd_booted"
        expression => isdir("/run/systemd/system");

      # The adapter writes /etc/systemd/system. On NixOS that path is a
      # symlink into the read-only store (/etc/static/systemd/system): a
      # unit exists there only if the Nix configuration declares it, and
      # the host's supervisor is `nixos`, never cfengine
      # (linux-targets.md section 5, nixos-passthrough-plan.md section 2).
      # Refuse by policy rather than half-fail on the write: a real,
      # non-symlink directory is required.
      #
      # Operand order is load-bearing (same reason as the header): a class
      # expression naming a class not yet defined reads it as false, and a
      # class once set is never re-evaluated. With `_writable` above its
      # operands, pass 1 set `_elsewhere` on every normal systemd host and
      # every present entry was reported "refused" while it was rendered in
      # pass 2 (seen in CI, 2026-11-01; present since the guard landed).
      "tendcf_systemd_units_dir"
        expression => isdir("/etc/systemd/system");

      "tendcf_systemd_units_link"
        expression => islink("/etc/systemd/system");

      "tendcf_systemd_units_writable"
        expression => "tendcf_systemd_units_dir.!tendcf_systemd_units_link";

      "tendcf_systemd_units_elsewhere"
        expression => "linux.tendcf_systemd_booted.!tendcf_systemd_units_writable";

      "tendcf_systemd_host"
        expression => "linux.tendcf_systemd_booted.tendcf_systemd_units_writable";

      "service_$(service_canon[$(service_ids)])_launchd"
        expression => strcmp("$(unit_flavour[$(service_ids)])", "launchd");

      "service_$(service_canon[$(service_ids)])_systemd"
        expression => strcmp("$(unit_flavour[$(service_ids)])", "systemd");

      "service_$(service_canon[$(service_ids)])_systemd_supported"
        expression => "service_$(service_canon[$(service_ids)])_systemd.tendcf_systemd_host";

      "service_$(service_canon[$(service_ids)])_supported"
        expression => "service_$(service_canon[$(service_ids)])_launchd.darwin|service_$(service_canon[$(service_ids)])_systemd_supported";

      "service_$(service_canon[$(service_ids)])_refused"
        expression => "service_$(service_canon[$(service_ids)])_present.!service_$(service_canon[$(service_ids)])_supported";

      # A tombstone has no unit, so it has no flavour and `_refused` (which
      # needs `_present`) cannot see it. Where the units are the system
      # configuration's, a tombstone is reported and never actuated (D3).
      "service_$(service_canon[$(service_ids)])_tombstone_elsewhere"
        expression => "tendcf_systemd_units_elsewhere.!service_$(service_canon[$(service_ids)])_present";

      # systemd actuation gate: the entry's own interlock bundle is met.
      "service_$(service_canon[$(service_ids)])_systemd_go"
        expression => "service_$(service_canon[$(service_ids)])_systemd_supported.!interlock_blocked_$(service_bundle_canon[$(service_ids)])";

      # `enabled` is the boot symlink (systemctl enable/disable); a present
      # service is started either way, as launchd's load -w starts it.
      "service_$(service_canon[$(service_ids)])_enabled"
        expression => strcmp("$(data:variables.tendcf_service[$(service_ids)][unit][systemd][enabled])", "true");

      # Pre-run snapshots of the manager's state. returnszero() results are
      # cached for the whole run (verified against the dev build), so these
      # keep the state from BEFORE any command below ran, which is what
      # lets one run converge without a second restart: a unit that was
      # inactive is started, not started and then restarted because pass 2
      # sees it active.
      "service_$(service_canon[$(service_ids)])_active"
        expression => returnszero("/usr/bin/systemctl is-active --quiet $(service_ids)", "noshell"),
        ifvarclass => "service_$(service_canon[$(service_ids)])_systemd_supported";

      "service_$(service_canon[$(service_ids)])_boot_enabled"
        expression => returnszero("/usr/bin/systemctl is-enabled --quiet $(service_ids)", "noshell"),
        ifvarclass => "service_$(service_canon[$(service_ids)])_systemd_supported";

      # Tombstone on a systemd host: tear down only a REGULAR file of that
      # name, which is what this adapter renders. Anything else at the path
      # is not ours to remove: an alias or enable-created link (pastebin's
      # /etc/systemd/system/sshd.service is an unowned alias link), a mask
      # (link to /dev/null), a dangling link, a directory. `fileexists` is
      # true for every one of those, so it is not the test; `isplain` is
      # true only for a regular file and does not follow links (run against
      # a real cf-agent, 3.29.0a: a link to a regular file is not plain
      # either). Passing this guard does NOT prove cfengine rendered the
      # file: who wrote a regular file is the lint's job (a tombstone must
      # fall under a cfengine unit-writer prefix, schema_lint.py), and it
      # does not stop `systemctl disable` from touching other links of the
      # unit (schema-v5-dpkg-reconciliation-2026-11-02.md section 6, S0).
      # launchd labels and runit names fall through untouched.
      "service_$(service_canon[$(service_ids)])_unit_plain"
        expression => isplain("/etc/systemd/system/$(service_ids)"),
        ifvarclass => "tendcf_systemd_host.!service_$(service_canon[$(service_ids)])_present";

      # Something is at the path and it is not a regular file: refused and
      # reported below, nothing run. `islink` is read as well, so a link is
      # refused whatever fileexists says about its target.
      "service_$(service_canon[$(service_ids)])_unit_exists"
        expression => fileexists("/etc/systemd/system/$(service_ids)"),
        ifvarclass => "tendcf_systemd_host.!service_$(service_canon[$(service_ids)])_present";

      "service_$(service_canon[$(service_ids)])_unit_linked"
        expression => islink("/etc/systemd/system/$(service_ids)"),
        ifvarclass => "tendcf_systemd_host.!service_$(service_canon[$(service_ids)])_present";

      "service_$(service_canon[$(service_ids)])_teardown"
        expression => "tendcf_systemd_host.!service_$(service_canon[$(service_ids)])_present.service_$(service_canon[$(service_ids)])_unit_plain";

      "service_$(service_canon[$(service_ids)])_teardown_refused"
        expression => "tendcf_systemd_host.!service_$(service_canon[$(service_ids)])_present.(service_$(service_canon[$(service_ids)])_unit_exists|service_$(service_canon[$(service_ids)])_unit_linked).!service_$(service_canon[$(service_ids)])_unit_plain";

  files:
      "/Library/LaunchDaemons/$(service_ids).plist"
        create => "true",
        edit_template => "$(this.promise_dirname)/templates/launchd.plist.mustache",
        template_method => "mustache",
        template_data => mergedata("data:variables.tendcf_service[$(service_ids)]",
                                    '{"id": "$(service_ids)"}'),
        ifvarclass => "service_$(service_canon[$(service_ids)])_launchd.darwin.!interlock_blocked_$(service_bundle_canon[$(service_ids)])";

      "/etc/systemd/system/$(service_ids)"
        create => "true",
        perms => tendcf_unit_perms,
        edit_defaults => tendcf_no_backup,
        edit_template => "$(this.promise_dirname)/templates/systemd.service.mustache",
        template_method => "mustache",
        template_data => mergedata("data:variables.tendcf_service[$(service_ids)]",
                                    '{"id": "$(service_ids)"}'),
        classes => tendcf_unit_rendered("service_$(service_canon[$(service_ids)])_unit_changed"),
        ifvarclass => "service_$(service_canon[$(service_ids)])_systemd_go";

      # A tombstone names no flavour; the launchd adapter owns its cleanup
      # on darwin and nothing can exist to clean elsewhere. This path has no
      # existence or type gate, by design: a plist is a plain file whoever
      # wrote it, so `isplain` would not tell ours from another writer's. Its
      # only guard is the lint (a tombstone must fall under a cfengine
      # unit-writer prefix; schema_lint.py, cases 129-131).
      "/Library/LaunchDaemons/$(service_ids).plist"
        delete => tendcf_tidy,
        ifvarclass => "darwin.!service_$(service_canon[$(service_ids)])_present";

      # Removal waits for the teardown command below (pass 2), because
      # `systemctl disable` needs the unit file still in place.
      "/etc/systemd/system/$(service_ids)"
        delete => tendcf_tidy,
        classes => tendcf_unit_removed,
        ifvarclass => "service_$(service_canon[$(service_ids)])_torn_down";

  commands:
      "/bin/launchctl"
        arglist => { "load", "-w", "/Library/LaunchDaemons/$(service_ids).plist" },
        ifvarclass => "service_$(service_canon[$(service_ids)])_launchd.darwin.!interlock_blocked_$(service_bundle_canon[$(service_ids)])";

      "/bin/launchctl"
        arglist => { "unload", "/Library/LaunchDaemons/$(service_ids).plist" },
        ifvarclass => "darwin.!service_$(service_canon[$(service_ids)])_present";

      # systemd. The files section ran first in this pass, so a rendered
      # unit is on disk before the manager is told about it.
      "/usr/bin/systemctl"
        arglist => { "daemon-reload" },
        ifvarclass => "tendcf_systemd_reload.!tendcf_cmdb_refused";

      "/usr/bin/systemctl"
        arglist => { "enable", "$(service_ids)" },
        ifvarclass => "service_$(service_canon[$(service_ids)])_systemd_go.service_$(service_canon[$(service_ids)])_enabled.!service_$(service_canon[$(service_ids)])_boot_enabled";

      "/usr/bin/systemctl"
        arglist => { "disable", "$(service_ids)" },
        ifvarclass => "service_$(service_canon[$(service_ids)])_systemd_go.!service_$(service_canon[$(service_ids)])_enabled.service_$(service_canon[$(service_ids)])_boot_enabled";

      "/usr/bin/systemctl"
        arglist => { "start", "$(service_ids)" },
        ifvarclass => "service_$(service_canon[$(service_ids)])_systemd_go.!service_$(service_canon[$(service_ids)])_active";

      # Changed unit, already running: restart so the new definition runs.
      "/usr/bin/systemctl"
        arglist => { "restart", "$(service_ids)" },
        ifvarclass => "service_$(service_canon[$(service_ids)])_systemd_go.service_$(service_canon[$(service_ids)])_active.service_$(service_canon[$(service_ids)])_unit_changed";

      "/usr/bin/systemctl"
        arglist => { "disable", "--now", "$(service_ids)" },
        classes => tendcf_command_done("service_$(service_canon[$(service_ids)])_torn_down"),
        ifvarclass => "service_$(service_canon[$(service_ids)])_teardown";

      # After a removal. Spelled differently from the first daemon-reload
      # so a run that already reloaded for a render still reloads again.
      "/usr/bin/systemctl"
        arglist => { "--quiet", "daemon-reload" },
        ifvarclass => "tendcf_systemd_unit_removed.!tendcf_cmdb_refused";

  reports:
      "interlock_blocked_$(interlock_bundle_canon[$(interlock_ids)])"::
        "tendcf: interlock '$(interlock_ids)' not satisfied, bundle '$(data:variables.tendcf_interlock[$(interlock_ids)][bundle])' refused";

      "service_$(service_canon[$(service_ids)])_refused.!(service_$(service_canon[$(service_ids)])_systemd.tendcf_systemd_units_elsewhere)"::
        "tendcf: service '$(service_ids)' refused: unit flavour '$(unit_flavour[$(service_ids)])' is not implemented on this host ($(sys.flavour); adapters: launchd on darwin, systemd on a Linux host booted by systemd)";

      "service_$(service_canon[$(service_ids)])_refused.service_$(service_canon[$(service_ids)])_systemd.tendcf_systemd_units_elsewhere"::
        "tendcf: service '$(service_ids)' refused: /etc/systemd/system is not a writable directory on this host ($(sys.flavour)); its units are written by the system configuration (supervisor nixos), not by cfengine";

      "service_$(service_canon[$(service_ids)])_tombstone_elsewhere"::
        "tendcf: service '$(service_ids)' tombstone not actuated: /etc/systemd/system is not a writable directory on this host ($(sys.flavour)); its units are the system configuration's (supervisor nixos)";

      "service_$(service_canon[$(service_ids)])_teardown_refused"::
        "tendcf: service '$(service_ids)' tombstone not actuated: /etc/systemd/system/$(service_ids) is not a regular file (an alias, mask, dangling link or directory); this adapter removes only a file it could have rendered";
}

body contain tendcf_interlock_contain(timeout)
{
      # noshell: cf-agent splits the joined pre_action string itself and
      # execv()s it (see the comment on pre_action_cmd). Never "useshell":
      # it would run the joined string through /bin/sh as root.
      useshell     => "noshell";
      exec_timeout => "$(timeout)";
}

body edit_defaults tendcf_no_backup
{
      # The default leaves <unit>.cf-before-edit beside the unit, in the
      # manager's own directory.
      edit_backup => "false";
}

body perms tendcf_unit_perms
{
      mode => "0644";
      rxdirs => "false";
}

body classes tendcf_unit_rendered(class)
{
      scope             => "namespace";
      promise_repaired  => { "$(class)", "tendcf_systemd_reload" };
}

body classes tendcf_unit_removed
{
      scope             => "namespace";
      promise_repaired  => { "tendcf_systemd_unit_removed" };
}

body classes tendcf_command_done(class)
{
      scope             => "namespace";
      kept_returncodes     => { "0" };
      repaired_returncodes => { "0" };
      promise_kept         => { "$(class)" };
      promise_repaired     => { "$(class)" };
}

body delete tendcf_tidy
{
      dirlinks => "delete";
      rmdirs   => "true";
}

body classes tendcf_interlock_result(class, code)
{
      # namespace: the verdict is read by tendcf_services, a later bundle.
      scope                => "namespace";
      kept_returncodes     => { "$(code)" };
      repaired_returncodes => { "$(code)" };
      promise_kept         => { "$(class)" };
      promise_repaired     => { "$(class)" };
}
