# tendcf's generic bundle (launchd on darwin, systemd on Linux).
#
# Reads $(data:variables.tendcf_service) / $(data:variables.tendcf_interlock)
# -- the data containers CFEngine's CMDB loader (LoadCMDBData/ReadCMDBVars in
# libpromises/cmdb.c) installs from $(sys.workdir)/data/host_specific.json's
# top-level "vars" key. Bare (unprefixed) CMDB keys default to namespace
# "data", scope "variables" (cmdb.c:GetCMDBVariableRef) -- confirmed against
# a real build, not assumed: an earlier draft of this file guessed the
# augments-loader's `def.*` scope, which is a DIFFERENT loader
# (LoadAugmentsData, used for def.json) that never runs on this file.
#
# host_specific.json is projector output and is policy-free: it only copies
# `state` verbatim per entry (goal-file-schema-reconciliation-2026-08-15.md,
# projector-reconciliation-2026-08-16.md C-1). Every decision below --
# present vs absent, whether an interlock's guard is met -- is this bundle's
# job, not the projector's.
#
# Interlocks are bundle-scoped refusal (architecture-DEFINITIVE-v3.md
# S7 / D16): an unmet interlock blocks every entry tagged with the same
# `bundle` name, not only the entries that reference the interlock
# directly. There is no literal per-service `bundle agent` -- nothing
# generates those -- so the scoping is reproduced with one guard class
# per distinct `bundle` tag (interlock_blocked_<tag>), computed once and
# checked by every entry carrying that tag.
#
# Two bundles, sequenced `tendcf_interlocks` then `tendcf_services`, and
# that order is load-bearing. CFEngine evaluates every `classes:` section
# of a bundle before any `commands:` section in each pass, and a class
# once defined is never undefined, so a verdict class computed in the same
# bundle as the pre_action command is fixed in pass 1 before the command
# has run (found 2026-10-29 with a real build: `interlock_blocked_demo`
# defined, THEN `/usr/bin/true` executed, THEN `interlock_ok_demo_check`
# set, refusal anyway). The commands therefore live in their own bundle
# with namespace-scoped outcome classes, and the services bundle reads a
# final verdict. Fail-closed is kept: a pre_action that never ran (dry-run
# `-n`, missing executable, timeout) leaves `interlock_ok_*` undefined and
# the bundle blocked.
#
# Entry ids and bundle tags are NOT valid CFEngine class-name fragments as
# written: the schema allows `.`/`-`/`@` (service ids can be a launchd
# label like "com.tendcf.caddy.main"; bundle tags are lowercase-kebab).
# CFEngine class names accept neither, confirmed against a real build
# ("Context string is invalid/out of range" on a raw hyphenated class).
# Every id/tag that becomes PART OF a class name goes through canonify()
# into its own variable first; raw ids are kept for data lookups and the
# rendered plist Label, where the real, uncanonified value is required.
#
# systemd adapter (linux-targets.md steps 4-5). Goal-file `unit.systemd`
# carries `enabled`, `restart` and `wanted_by`, all explicit:
#   - the unit is /etc/systemd/system/<id>, rendered from
#     templates/systemd.service.mustache (Type=simple; Restart= and
#     WantedBy= from the entry);
#   - every command argv element is double-quoted into ExecStart and
#     nothing is escaped: the goal-file schema holds a systemd entry's argv
#     and working_dir to an alphabet with no `"`, `\`, `$`, `%` or control
#     character, so a value systemd would re-read never reaches the
#     template (goal-file.schema.json, service_present allOf);
#   - run order per pass is files (render, or delete after teardown) then
#     commands: daemon-reload, enable/disable, start, restart, teardown,
#     reload after removal. State probes are snapshots (see the classes
#     section), so one run converges and the next does nothing.
#
# launchd adapter (darwin system + user-gui + user-background domains;
# C-policy-03, C-policy-04, C-policy-05, issues #70, #94, #103):
#   - production entry point `tendcf_services` enforces fail-closed root/user
#     privilege separation using `sys.user_data[uid|username|gid|home_dir]`
#     (populated from getpwuid(getuid()), never $HOME/$USER):
#       * root (uid == 0) calls `tendcf_services_apply("system",
#         "/Library/LaunchDaemons", "/bin/launchctl", "root", "wheel", "root",
#         "0")` and actuates `domain: "system"` only (informationally skipping
#         valid `user-gui` and `user-background` entries under Q1);
#       * non-root (uid != 0) calls `tendcf_services_apply("user",
#         "$(sys.user_data[home_dir])/Library/LaunchAgents", "/bin/launchctl",
#         "$(sys.user_data[username])", "$(sys.user_data[gid])",
#         "$(sys.user_data[username])", "$(sys.user_data[uid])")` and actuates
#         `domain: "user-gui"` (`gui/<uid>`, `LimitLoadToSessionType=Aqua`) and
#         `domain: "user-background"` (`user/<uid>`,
#         `LimitLoadToSessionType=Background`) when `run_as` matches the
#         running user (informationally skipping valid `domain: "system"` under
#         Q1, refusing invalid/missing/stale-v8 `"user"` domains and mismatched
#         `run_as`).
#     No goal file, host_specific.json, def.json, environment variable or -D
#     class can override those paths, domain or ownership in production; only a
#     separate policy file calling `tendcf_services_apply(...)` directly
#     (tests/policy/run.sh's non-root harness) can pass scratch paths;
#   - once-per-run domain-level availability probes (user mode only, when at
#     least one present user service or user tombstone is eligible):
#       * `launchctl print gui/<uid>`: exit 0 -> `gui_available`; exit 125/112
#         -> `gui_absent` (confirmed headless); any other exit/timeout ->
#         `gui_probe_failed` (fail closed on user-gui, user-background, and
#         tombstones);
#       * `launchctl print user/<uid>`: exit 0 -> `user_available`; exit 112 ->
#         `user_absent` (125 is NOT accepted as absent); any other exit/timeout
#         -> `user_probe_failed` (fail closed);
#   - headless deferral: when `gui_absent`, `user-background` converges cleanly
#     in `user/<uid>`, while `user-gui` emits a distinct `deferred:` notice
#     with no plist written and no `bootstrap gui/<uid>` (still sweeping any
#     stale peer job in `user/<uid>` on a `user-background` -> `user-gui`
#     domain switch; caveat: the stale `LimitLoadToSessionType=Background` plist
#     remains on disk while headless and is self-healed on the first post-login
#     run — even if launchd auto-loads it into `user/<uid>` first, the peer
#     sweep boots out `user/<uid>/<label>` before rewriting to `Aqua` and
#     bootstrapping `gui/<uid>`);
#   - peer-domain anti-dual-load sweep (user mode present services): before
#     rendering/bootstrapping into the target domain, if the peer domain is
#     available, probe `launchctl print <peer>/<label>` (113/3 -> clear; 0 ->
#     `launchctl bootout <peer>/<label>` by service-target; any error fails
#     closed and blocks target bootstrap);
#   - service-id collision guard (fail-closed): if any two distinct entries in
#     `service_ids` share a `canonify()` value (e.g. `.`, `-`, `_`, `@` all map
#     to `_`) or, on darwin, differ only in ASCII case (case-insensitive APFS),
#     ALL service actuation and probes are refused and reported;
#   - plists are rendered from templates/launchd.plist.mustache (omitting
#     `create => "true"` so Mustache renders in memory before creating a file
#     and never leaves a 0-byte plist on render failure) with mode 0644,
#     root:wheel ownership in system mode (user-owned in user mode), and
#     edit_defaults => tendcf_no_backup (no `.cf-before-edit` backup left in
#     the launchd dir; C-policy-05). `launchd_include_username` and
#     `launchd_session_type` are injected via trailing literal `mergedata()`
#     objects so no untrusted service field can spoof them.
#     Perms- or owner-only drift repairs metadata and triggers a bootout +
#     bootstrap restart (intentional: launchd rejects insecure plists at boot);
#   - present loaded-state probe is `launchctl print <target>/<label>` via
#     returnszero() (cached pre-run snapshot while `cache_system_functions` is
#     true; reload bootout also guards on `!_launchd_bootstrapped`). launchctl(1)
#     EXIT STATUS defines only 0 (success) vs non-zero (error code decodable by
#     `launchctl error`, not a closed per-subcommand table), and `print` warns
#     its output is NOT API; empirically macOS returns 113 ("Could not find
#     specified service") when unloaded. We never parse stdout/stderr;
#   - actuation (C-policy-03): bootstrap when not loaded (note: unlike legacy
#     `load -w`, `bootstrap` respects a persistent `launchctl disable` override
#     and fails if the label is disabled); bootout `<target>/<label>` then
#     bootstrap only when the files promise repaired the plist or a persistent
#     reload-pending class survived an earlier failed/skipped bootout; nothing
#     when unchanged and loaded; failed render or failed bootout halts later
#     steps and reports (suppressed under `-n` / `opt_dry_run` so dry-run
#     previews cleanly without false errors). Caveat (M2): real launchd can
#     return 0 from `bootout` before releasing the label, causing an immediate
#     `bootstrap` to fail with EIO (5); if that happens, the failure is reported
#     and the next run sees the service unloaded and bootstraps cleanly (the
#     issue 70 VM slice exercises live drift-reload);
#   - tombstone gate (C-policy-04, issue #103 Q2): requires explicit
#     `state == "absent"`, `!_present`, a valid launchd label id, `isplain`
#     (regular file only — symlinks, dangling links and directories are refused
#     and reported with no launchctl call), and an exact-case directory entry
#     in `$(launchd_dir)` via `lsdir()` (preventing case-only APFS deletion of
#     a differently-cased plist). System-mode tombstones probe `system/<label>`
#     via a read-only `commands:` `launchctl print` (`preview => "true"`,
#     `exec_timeout => "60"`): exit 0 = loaded (`bootout`, then pass-2 delete
#     only on exit 0), exit 113 or 3 = confirmed unloaded (pass-2 delete
#     directly), any other exit/timeout = fail closed (plist left in place,
#     failure reported). User-mode tombstones sweep BOTH `gui/<uid>` and
#     `user/<uid>` legs (absent domain = clear; available domain = read-only
#     `print` + `bootout` if loaded; any probe/bootout error on either leg
#     fails closed and keeps the plist on disk). Limit: `isplain` does not
#     distinguish a tendcf-rendered regular plist from a third-party regular
#     plist; enforcing unit-writer prefix ownership on-device requires
#     tendcf-validate before projection (projecting unit-writer reverses P-1).
#
# CMDB cross-check (`tendcf_cmdb`, proposal 2026-11-03 section 13, option 3,
# operator ruling Q10 2026-11-02). Everything above assumes CFEngine's loader
# installed what host_specific.json says. Nothing promises that for every
# engine: the fork before 2026-11-02 (`8f0076b81`, B-5b) skipped a bad entry on
# its own and still returned success, and a skipped `tendcf_interlock` leaves
# every service ungated (services are gated negatively, on
# `!interlock_blocked_*`, and that class only exists for an interlock that
# loaded). The fork at the pin (overlay/fork.json, PR #41, operator ruling R13)
# loads all-or-nothing instead: an invalid entry, a repeated object member
# anywhere, non-whitespace after the document, a class name with whitespace at
# either end, a variable that exists already, and it installs none of the file,
# so this check, if its lenient view lists any `vars` key, sees every one of
# them missing and refuses. That strict parse
# is the CMDB loader's only: `readjson`, which this check reads the file with,
# and def.json stay lenient, so after a repeated member or a repeated `vars`
# section the check sees the LAST one only (an earlier container is not named).
# It reports a refusal when that lenient view still lists variables the loader
# did not install (or another feature it refuses on its own). When the lenient
# view is EMPTY nothing is installed and nothing actuates, but the check has
# nothing to report: no actuation is not a refusal report, and the loader's own
# error is then the only trace (tests/policy/run.sh 9b, empty-view controls,
# which pin two examples, `{"vars":{},"vars":{}}` and `{"vars":{}}` plus
# non-whitespace after it). The examples are not the whole class. The one that
# matters operationally is `{"vars":{<the real configuration>},"vars":{}}`: the
# lenient parser keeps the last, empty `vars`, the strict loader refuses the
# file, and the whole intended configuration is silently not applied, with the
# loader's error as the only trace. The two are
# not fully independent for that reason, and each holds for a loader that fails
# closed, for one that does not, and for a gap in either, to the extent the
# other does not share the gap. The check does not model WHY an entry was
# dropped. It reads the file itself and compares it with what the loader installed:
#   - the file's top-level keys must be exactly `vars`. The loader also applies
#     a `variables` section (after `vars`; upstream CFEngine lets it replace a
#     same-named variable, the fork at the pin refuses a file that names one
#     variable twice) and a `classes` section (which can define `interlock_ok_*`);
#     the projector emits neither (N-2, bin/projector.py check_projection), so
#     any other top-level key is refused rather than compared;
#   - every key under `vars` must be a plain identifier ([A-Za-z0-9_]+). The
#     loader reads a key as a variable reference (cmdb.c GetCMDBVariableRef,
#     VarRefParse): `a.b` lands in scope a, `ns:b.c` in another namespace,
#     `a[i]` is an array element. Such a key can preset a variable of THIS
#     policy (`default:tendcf_services_apply.service_ids`), so it is refused;
#   - for every key under `vars`, `data:variables.<key>` must exist;
#   - per key, the set of entry ids in the file must equal the set of
#     indices of the loaded container (a half-loaded container is caught);
#   - per key, the whole container the loader installed must equal the file's:
#     storejson() of `doc[vars][<key>]` against storejson() of
#     `data:variables.<key>`, string-equal (same parser and same bytes give the
#     same text, key order and number formatting included). A value that is not
#     an object is refused when it reads back differently: the loader installs
#     a scalar as a string (storejson() fails) and a list of primitives as an
#     slist of strings (numbers read back as strings; a list of strings reads
#     back equal and is accepted). Equal ids with changed values, as a
#     loader that replaced a container (upstream's `variables` section) would
#     give, are caught. A comparison that cannot be
#     computed is a problem of its own (`..._problem_uncomparable_<key>`, or
#     `..._problem_noverdict_<key>` when both texts exist but neither equality
#     nor a difference could be evaluated), not the absence of a difference;
#   - every `data:variables.*` the loader installed must be a key of `vars`
#     in the file;
#   - nothing the loader installed may lie outside `data:variables.<identifier>`:
#     no CMDB-installed variable of any other name, and no CMDB-installed class.
#     This is read from the loaded state (the variable table and the class
#     table, by the tag the loader puts on everything it installs,
#     `source=cmdb`), not from the file, in class expressions that call
#     variablesmatching() and classmatch() inline, so it names no variable that
#     a CMDB key could preset. It is what keeps the checker's own variables and
#     the gates' id lists out of reach (see "Presets" below). It also covers the
#     augments file (`def.json`, tag `source=augments_file`, loaded after the
#     CMDB): tendcf ships none, and a variable or class from one is refused
#     the same way (a host that needs a `def.json` must be given an exemption
#     here, deliberately);
#   - a file that exists but cannot be parsed (or exceeds the loader's own
#     5 MiB cap), and loaded data with no file at all, are mismatches.
# A missing file with nothing loaded is the normal empty case: no class, no
# report. A key the loader files elsewhere (`a.b`, `ns:b.c`) cannot match
# `data:variables.<key>`, so it reads as a mismatch: refused, never ignored.
# The data directory is `$(sys.workdir)/data` here; the loader uses
# GetDataDir() (CF_DATADIR, default <workdir>/data). A build with another data
# dir would compare against the wrong file and mostly fail closed.
#
# On any mismatch the single class `tendcf_cmdb_refused` is defined and
# NOTHING is actuated: no interlock pre_action, no service, no tombstone. The
# gate is one place per bundle: `interlock_ids` and `service_ids` are set to
# empty lists under the refusal, and every promise that acts iterates one of
# them. The two daemon-reload commands, which iterate no id, carry
# `!tendcf_cmdb_refused` themselves (a `classes` section could otherwise define
# their trigger classes; it is refused as well, but a refusal must not depend on
# that). A new actuating promise MUST iterate those ids or carry
# `!tendcf_cmdb_refused` itself. The mismatch is reported once, by
# tendcf_interlocks. Reports print file-derived text (keys, entry ids, section
# names) only after replacing every character outside [A-Za-z0-9._:@/-] with `?`
# and cutting it to a fixed length; the refusal summary and the foreign
# variable and class reports are static text.
#
# Presets. The loader installs a `vars` key under any name, so a key such as
# `default:tendcf_cmdb.doc` or `default:tendcf_services_apply.interlock_ids` presets
# that variable before any policy runs. What a preset does then depends on the
# promise (verify_vars.c VerifyVarPromise, read at commit b8abf28408b1; the
# pin in overlay/fork.json is now 4443504, which differs from it only in
# libpromises/cmdb.c, cmdb.h, tests, .gitmodules and the libntech submodule pointer): a promise with a LITERAL rvalue (`slist => { }`) always
# redefines it, so the policy's value stands. A promise whose rvalue is a
# FUNCTION CALL is skipped when the variable exists ("Already did this") if the
# call was not already evaluated to a value when the promise runs, and
# otherwise redefines it; which of the two happens is not something this policy
# relies on (tests/policy/run.sh check 9 saw both: some presets of the checker's
# and the gates' variables stayed, some were replaced by the policy's value).
# So the check does not try to make each variable immune: any variable the CMDB
# (or an augments file) installed under a name other than
# `data:variables.<identifier>` and still carrying the loader's tag when the
# classes are evaluated makes `tendcf_cmdb_problem_foreign_var`, read from the
# variable table, and a preset that was replaced is the policy's own value. The
# checker's `doc` is guarded to be read once, so a preset of it is never
# overwritten by a later pass and is refused by that class. Under the refusal
# the id lists are literal empty lists, which redefine a preset.
#
# Order and evaluation, as measured on the pinned fork (tests/policy/run.sh
# check 11, debug run of a real cf-agent, the replaced-file case): `tendcf_cmdb`
# was resolved 2 times, its vars `doc` promise was visited 1 time (skipped once
# `doc` exists), `file_json[..]` 10 times and the class `tendcf_cmdb_refused` 2
# times; the mutation script ran 1 time. So the vars are visited on every
# resolution, and a class is set once and never cleared, while a class that is
# still unset is evaluated again on the second resolution, from the same
# snapshot. The fork evaluates the vars and the classes of every
# `bundle common` before the vars of any other bundle, independently of
# `bundlesequence` (PolicyResolve and BundleResolve, libpromises/expand.c:846-871
# and 1145-1177), so `tendcf_cmdb_refused` is decided, on the first pass over
# the file, before the `!tendcf_cmdb_refused` on the agent bundles' `*_ids` is
# first read. A later vars pass that re-read the file would see a replacement
# the decision never compared, so `doc` is read ONCE: its promise is skipped
# once `doc` exists, every comparison input is derived from that one snapshot,
# and no later pass reads the file. The probe of check 11 replaces the file
# between the passes and shows that the loaded data are acted on and the
# replacement is not. Each problem class is defined from the current comparison,
# in positive form (a difference, an uncomputable side, a foreign variable),
# never as the negation of a class set once and never cleared: a promise for an
# already-set class is skipped (libpromises/promises.c), so "not equal" read
# from a sticky "equal" class would stay false after a later mismatch. The
# classes of the common bundle run in one pass in written order:
# `tendcf_cmdb_refused` comes after every `tendcf_cmdb_problem_*` class; do not
# reorder them. `tendcf_cmdb_json_same_<key>` (the two texts are equal) is read
# only by `..._problem_noverdict_<key>`, which refuses a comparison that gave
# neither "equal" nor "differs" (strcmp() is skipped when an argument still holds
# `$(`); it comes after the classes it reads and cannot hide a difference.
#
# One file on purpose: the fork resolves each file's bundles when it is loaded
# and the whole policy again afterwards (libpromises/loading.c), so `tendcf_cmdb`
# decides in the file it shares with the gated bundles, before their ids are
# first read. Were it split off, the literal empty `*_ids` lists under the
# refusal would still redefine the ids, so it would fail closed, but this is why
# the bundles live together.
#
# What is NOT guaranteed: the check compares the file with the loader's state at
# the evaluation. A file replaced after the last evaluation, or by a promise
# that changes `data:variables.*` afterwards, is not seen; and nothing here makes
# a publication atomic (`tendcf-install.sh data` installs by atomic rename, but
# the agent can still start between the loader's read and ours). Not a sandbox
# either: it is a consistency check between the file and what the loader
# installed. A CMDB author (root) already chooses each pre_action executable,
# `/bin/sh -c ...` included, and the unit commands, so it does not stop a hostile
# but self-consistent file; it stops a file and a loader that disagree, and the
# sections, keys, variables and classes through which a file could change what
# the policy reads without showing up as a `vars` difference.

bundle common tendcf_cmdb
{
  vars:
      "file"
        string => "$(sys.workdir)/data/host_specific.json";

      # 5242880 = the loader's HOST_SPECIFIC_DATA_MAX_SIZE (5 MiB). An absent
      # file leaves `doc` undefined and is not an error.
      #
      # Read ONCE (see "Order and evaluation"): the engine visits this promise on
      # every later pass, and a second read could return a file the classes never
      # compared. `not(isvariable("doc"))` skips it once `doc` exists, a preset
      # included (which is then refused as a foreign variable).
      "doc"
        data => readjson("$(file)", 5242880),
        ifvarclass => and(fileexists("$(file)"), not(isvariable("doc")));

      "file_keys"
        slist => getindices("doc[vars]"),
        ifvarclass => isvariable("doc[vars]");

      "file_keys"
        slist => { },
        ifvarclass => not(isvariable("doc[vars]"));

      # Top-level sections of the file. The loader applies `vars`, `variables`
      # and `classes` (cmdb.c LoadCMDBData); the projector emits only `vars`,
      # and anything else is refused (class `..._problem_sections`). A top-level
      # array reads as indices "0", "1", ... here and is refused the same way.
      "doc_sections"
        slist => getindices("doc"),
        ifvarclass => isvariable("doc");

      "doc_sections"
        slist => { },
        ifvarclass => not(isvariable("doc"));

      "allowed_sections"
        slist => { "vars" };

      "extra_sections"
        slist => difference("doc_sections", "allowed_sections");

      # Only a plain identifier is a `vars` key this policy will look up. The
      # grep() pattern is anchored by CFEngine. Every other key is refused as a
      # whole (`..._problem_badkey`) and is never used to build a variable name
      # below.
      "safe_keys"
        slist => grep("[A-Za-z0-9_]+", "file_keys");

      "bad_keys"
        slist => difference("file_keys", "safe_keys");

      "loaded_refs"
        slist => variablesmatching("^data:variables\..*");

      "loaded_keys"
        slist => maplist(regex_replace("$(this)", "^data:variables\.", "", ""),
                         "loaded_refs");

      "missing_keys"
        slist => difference("file_keys", "loaded_keys");

      "unlisted_keys"
        slist => difference("loaded_keys", "file_keys");

      # Printable forms for the reports: every character outside the safe set
      # becomes `?`, then each name is cut to 64 characters (two steps, each the
      # same maplist idiom as loaded_keys). Keys, ids and section names come
      # from the file and may hold newlines or escape sequences.
      "missing_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "missing_keys");
      "missing_clean"
        slist => maplist(string_head("$(this)", 64), "missing_san");

      "unlisted_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "unlisted_keys");
      "unlisted_clean"
        slist => maplist(string_head("$(this)", 64), "unlisted_san");

      "bad_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "bad_keys");
      "bad_clean"
        slist => maplist(string_head("$(this)", 64), "bad_san");

      "sections_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "extra_sections");
      "sections_clean"
        slist => maplist(string_head("$(this)", 64), "sections_san");

      "loaded_san"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "loaded_keys");
      "loaded_clean"
        slist => maplist(string_head("$(this)", 64), "loaded_san");

      "key_canon[$(safe_keys)]"
        string => canonify("$(safe_keys)");

      # The key as a report shows it: at most 64 characters (a safe key is a plain
      # identifier, so no character replacement is needed, but its length is not
      # bounded). Lookups and class names keep using the full `safe_keys`.
      "key_clean[$(safe_keys)]"
        string => string_head("$(safe_keys)", 64);

      "file_ids[$(safe_keys)]"
        slist => getindices("doc[vars][$(safe_keys)]");

      "loaded_ids[$(safe_keys)]"
        slist => getindices("data:variables.$(safe_keys)");

      "unloaded_ids[$(safe_keys)]"
        slist => difference("file_ids[$(safe_keys)]", "loaded_ids[$(safe_keys)]");

      "unfiled_ids[$(safe_keys)]"
        slist => difference("loaded_ids[$(safe_keys)]", "file_ids[$(safe_keys)]");

      "unloaded_san[$(safe_keys)]"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "unloaded_ids[$(safe_keys)]");

      "unloaded_clean[$(safe_keys)]"
        slist => maplist(string_head("$(this)", 64), "unloaded_san[$(safe_keys)]");

      "unloaded_joined[$(safe_keys)]"
        string => join(", ", "unloaded_clean[$(safe_keys)]");

      "unloaded_text[$(safe_keys)]"
        string => string_head("$(unloaded_joined[$(safe_keys)])", 400);

      "unfiled_san[$(safe_keys)]"
        slist => maplist(regex_replace("$(this)", "[^A-Za-z0-9._:@/-]", "?", "g"),
                         "unfiled_ids[$(safe_keys)]");

      "unfiled_clean[$(safe_keys)]"
        slist => maplist(string_head("$(this)", 64), "unfiled_san[$(safe_keys)]");

      "unfiled_joined[$(safe_keys)]"
        string => join(", ", "unfiled_clean[$(safe_keys)]");

      "unfiled_text[$(safe_keys)]"
        string => string_head("$(unfiled_joined[$(safe_keys)])", 400);

      # The whole container, as JSON text, from the file and as installed.
      # storejson() fails (the variable stays undefined) for anything that is
      # not a container or list, and for a name that is not defined; the
      # `uncomparable` class below makes an undefined side a problem.
      "file_json[$(safe_keys)]"
        string => storejson("doc[vars][$(safe_keys)]");

      "loaded_json[$(safe_keys)]"
        string => storejson("data:variables.$(safe_keys)");

  classes:
      "tendcf_cmdb_problem_unreadable"
        expression => and(fileexists("$(file)"),
                          not(isvariable("tendcf_cmdb.doc")));

      "tendcf_cmdb_problem_nofile"
        expression => and(not(fileexists("$(file)")),
                          isgreaterthan(length("loaded_keys"), 0));

      "tendcf_cmdb_problem_missing"
        expression => isgreaterthan(length("missing_keys"), 0);

      "tendcf_cmdb_problem_unlisted"
        expression => isgreaterthan(length("unlisted_keys"), 0);

      "tendcf_cmdb_problem_sections"
        expression => isgreaterthan(length("extra_sections"), 0);

      "tendcf_cmdb_problem_badkey"
        expression => isgreaterthan(length("bad_keys"), 0);

      # Read from the loaded state, with the calls inline: no variable here for
      # a CMDB key to preset. Every variable tagged by the CMDB loader or by the
      # augments loader is counted, and so is every one of them that is exactly
      # data:variables.<identifier> AND tagged by the CMDB loader; any excess is
      # a variable of another name (or from augments), which is a problem.
      "tendcf_cmdb_problem_foreign_var"
        expression => isgreaterthan(length(variablesmatching(".*", "source=cmdb", "source=augments_file")),
                                    length(variablesmatching("data:variables\.[A-Za-z0-9_]+", "source=cmdb")));

      "tendcf_cmdb_problem_foreign_class"
        expression => classmatch(".*", "source=cmdb", "source=augments_file");

      "tendcf_cmdb_problem_partial_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          or(isgreaterthan(length("unloaded_ids[$(safe_keys)]"), 0),
                             isgreaterthan(length("unfiled_ids[$(safe_keys)]"), 0)));

      # The two texts, computed now, differ. Defined only when both exist (an
      # undefined side leaves the strcmp() argument unexpanded and the
      # expression undefined; that case is the next class).
      "tendcf_cmdb_problem_differs_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          isvariable("file_json[$(safe_keys)]"),
                          isvariable("loaded_json[$(safe_keys)]"),
                          not(strcmp("$(file_json[$(safe_keys)])",
                                     "$(loaded_json[$(safe_keys)])")));

      # The two texts, computed now, are equal. Positive and set once, like every
      # class here, and it is read only by the no-verdict class below, so it can
      # only silence a no-verdict refusal; it never suppresses
      # `..._problem_differs_` or `..._problem_uncomparable_`, which do not read
      # it. The inputs are one snapshot (`doc` is read once, the loaded
      # containers do not change), so the comparison gives the same result on
      # every evaluation.
      "tendcf_cmdb_json_same_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          isvariable("file_json[$(safe_keys)]"),
                          isvariable("loaded_json[$(safe_keys)]"),
                          strcmp("$(file_json[$(safe_keys)])",
                                 "$(loaded_json[$(safe_keys)])"));

      # A loaded container for which one side could not be serialised. Needs only
      # isvariable(), whose arguments are literal names, so it cannot be
      # suppressed by an undefined variable.
      "tendcf_cmdb_problem_uncomparable_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          or(not(isvariable("file_json[$(safe_keys)]")),
                             not(isvariable("loaded_json[$(safe_keys)]"))));

      # Both containers serialised, and yet neither "equal" nor "differs" was
      # computed: strcmp() is skipped (the call fails, so the class stays
      # undefined) when an argument still holds `$(` or `${` after expansion,
      # which a file replaced after the loader's read can give (the loader itself
      # refuses `$(`, `${`, `@(`, `@{` in a key or a value). No verdict is not
      # agreement: refuse. Written after the two classes it reads.
      "tendcf_cmdb_problem_noverdict_$(key_canon[$(safe_keys)])"
        expression => and(isvariable("data:variables.$(safe_keys)"),
                          isvariable("file_json[$(safe_keys)]"),
                          isvariable("loaded_json[$(safe_keys)]"),
                          not("tendcf_cmdb_json_same_$(key_canon[$(safe_keys)])"),
                          not("tendcf_cmdb_problem_differs_$(key_canon[$(safe_keys)])"));

      "tendcf_cmdb_refused"
        expression => classmatch("tendcf_cmdb_problem_.*");
}

bundle agent tendcf_interlocks
{
  vars:
      # Empty under a CMDB mismatch (see `tendcf_cmdb`): with no ids no
      # pre_action command is even built. Set explicitly, not left undefined:
      # a `vars` key such as "default:tendcf_interlocks.interlock_ids" would
      # have preset the list before the policy loaded, and a skipped promise
      # does not remove it.
      "interlock_ids"
        slist => getindices("data:variables.tendcf_interlock"),
        ifvarclass => "!tendcf_cmdb_refused";

      "interlock_ids"
        slist => { },
        ifvarclass => "tendcf_cmdb_refused";

      "interlock_canon[$(interlock_ids)]"
        string => canonify("$(interlock_ids)");

      # commands: promise runs <promiser> <arglist...>, and non-scalar
      # attributes (arglist, template_data below) can't take an indexed
      # data-container element directly -- CFEngine rejects "container
      # assigned to an indexed variable name" for that, and neither `@()`
      # nor bare `$()` accept a bracket path as a full non-scalar rvalue
      # (confirmed against a real build; both give parse errors, not just
      # a hunch). join() over the container path (a proven idiom: pass
      # the path as a plain string, CFEngine resolves it) sidesteps that.
      #
      # Guarantee, stated exactly: CFEngine starts no shell of its own for
      # this promise. tendcf_interlock_contain sets useshell => "noshell",
      # so cf-agent splits the joined string itself
      # (libpromises/exec_tools.c ArgSplitCommand: on whitespace, and an
      # argument that BEGINS with " ' or ` runs to the matching quote) and
      # execv()s the result: argv[0] is the program, the rest reach it
      # unchanged. `;`, `|`, `&&`, redirection and backticks mid-word are
      # plain arguments, never operators, and there is no PATH search.
      # That is NOT a sandbox: an author who declares ["/bin/sh", "-c", ...]
      # (schema-valid) still gets that shell, because the chosen program
      # interprets its own arguments. What is removed is the implicit
      # root shell over a joined string.
      #
      # The join is lossy for an element with whitespace, a leading quote or
      # an empty string, so the schema holds pre_action.command to an
      # alphabet with none of them (common.schema.json $defs/interlock_argv:
      # absolute command[0], then [A-Za-z0-9._+@:=,/-] only), pinned by
      # examples/broken/156-159, 161-174 and 176 (the services
      # contract_version by 160 and 175) and by tests/policy/run.sh check 8,
      # which records the argv a program receives. Remaining limit: nothing on
      # the device re-checks the schema. A projection that skipped it (the
      # projector only refuses `$(`, `${`, `@(`, `@{`; `tendcf-install.sh
      # data` installs without it) can carry a space or leading quote,
      # which shifts argv, or a relative command[0], which the guard on the
      # commands promise below refuses. Removing the join altogether (an
      # slist per interlock from getvalues(), passed as arglist) is
      # deliberately not done until proven against a real build.
      "pre_action_cmd[$(interlock_ids)]"
        string => join(" ",
          "data:variables.tendcf_interlock[$(interlock_ids)][pre_action][command]");

  commands:
      # pre_action: run the interlock's check under its own timeout, and
      # classify strictly by the entry's own expect_exit -- not bare
      # zero, since the schema allows any code 0-255.
      #
      # `if` fails closed on a relative command[0]: cf-agent would stat it
      # and execv() it against its own working directory (it is not a PATH
      # lookup), so the schema's absolute-path rule is re-enforced here for
      # a projection that skipped the schema (so a quoted absolute command[0],
      # "/bin/x", is refused too: the guard wants a leading `/`). A skipped promise leaves
      # interlock_ok_* undefined and the bundle blocked and reported.
      "$(pre_action_cmd[$(interlock_ids)])"
        if => regcmp("/.*", "$(pre_action_cmd[$(interlock_ids)])"),
        contain => tendcf_interlock_contain(
          "$(data:variables.tendcf_interlock[$(interlock_ids)][pre_action][timeout_seconds])"),
        classes => tendcf_interlock_result(
          "interlock_ok_$(interlock_canon[$(interlock_ids)])",
          "$(data:variables.tendcf_interlock[$(interlock_ids)][pre_action][expect_exit])");

  reports:
      # Why the promise above was skipped, so the blocked bundle's report
      # (tendcf_services, "not satisfied ... refused") has a cause beside it.
      # Best effort: inside the reports promise's ifelapsed window a second
      # agent run can suppress the line, while the refusal itself still holds
      # (it comes from interlock_ok_* staying undefined). The line is also
      # not printed when `command` is not an array or pre_action is missing
      # (the join then has no first element to test); the bare refusal line
      # still is.
      "tendcf: interlock '$(interlock_ids)' pre_action command[0] is not an absolute path; refused"
        if => not(regcmp("/.*", "$(pre_action_cmd[$(interlock_ids)])"));

      # The one report of a CMDB mismatch (tendcf_cmdb decides, this says).
      # First bundle of the sequence, so it comes before anything else.
      "tendcf_cmdb_refused"::
        "tendcf: CMDB cross-check failed: refusing to actuate anything (no interlock pre_action, no service, no tombstone) until $(tendcf_cmdb.file) and the data CFEngine loaded from it agree";

      "tendcf_cmdb_problem_unreadable"::
        "tendcf: CMDB cross-check: $(tendcf_cmdb.file) exists but cannot be read as JSON (parse error or larger than 5242880 bytes)";

      "tendcf_cmdb_problem_nofile"::
        "tendcf: CMDB cross-check: $(tendcf_cmdb.file) does not exist but CFEngine loaded data:variables.$(tendcf_cmdb.loaded_clean)";

      "tendcf_cmdb_problem_missing"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.missing_clean)' is under 'vars' in $(tendcf_cmdb.file) but CFEngine did not load data:variables.$(tendcf_cmdb.missing_clean) (the loader did not install it)";

      "tendcf_cmdb_problem_unlisted"::
        "tendcf: CMDB cross-check: CFEngine loaded data:variables.$(tendcf_cmdb.unlisted_clean), which is not a key under 'vars' in $(tendcf_cmdb.file)";

      "tendcf_cmdb_problem_partial_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' loaded differently from $(tendcf_cmdb.file): in the file only: [$(tendcf_cmdb.unloaded_text[$(tendcf_cmdb.safe_keys)])]; loaded only: [$(tendcf_cmdb.unfiled_text[$(tendcf_cmdb.safe_keys)])]";

      "tendcf_cmdb_problem_differs_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' content differs between $(tendcf_cmdb.file) and the data CFEngine loaded";

      "tendcf_cmdb_problem_uncomparable_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' content could not be compared between $(tendcf_cmdb.file) and the data CFEngine loaded (one side is not a container or list)";

      "tendcf_cmdb_problem_noverdict_$(tendcf_cmdb.key_canon[$(tendcf_cmdb.safe_keys)])"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.key_clean[$(tendcf_cmdb.safe_keys)])' content comparison reached no verdict between $(tendcf_cmdb.file) and the data CFEngine loaded (a text that cannot be evaluated, such as one holding a variable reference)";

      "tendcf_cmdb_problem_sections"::
        "tendcf: CMDB cross-check: $(tendcf_cmdb.file) has top-level section '$(tendcf_cmdb.sections_clean)' besides 'vars'; only 'vars' is accepted (the loader would also apply 'variables' and 'classes')";

      # Static text on purpose: the names are in `cf-promises --show-vars`
      # (tag source=cmdb or source=augments_file) and `--show-classes`.
      "tendcf_cmdb_problem_foreign_var"::
        "tendcf: CMDB cross-check: the CMDB or an augments file installed a variable outside data:variables.<identifier> (a preset of a variable of this policy or of another bundle); only data:variables.<identifier> is accepted";

      "tendcf_cmdb_problem_foreign_class"::
        "tendcf: CMDB cross-check: the CMDB or an augments file defined a class; no class from either is accepted";

      "tendcf_cmdb_problem_badkey"::
        "tendcf: CMDB cross-check: key '$(tendcf_cmdb.bad_clean)' under 'vars' in $(tendcf_cmdb.file) is not a plain identifier ([A-Za-z0-9_]+); the loader would read it as a variable reference";
}

bundle agent tendcf_ensure_user_launchagents(home_dir, owner)
{
  classes:
      # Safe creation guard for ~/Library/LaunchAgents (Codex Bot P2 / Opus L8):
      # require a non-root absolute home_dir without `..` traversal, a valid
      # owner name, a real non-symlink Library directory, and that LaunchAgents
      # does not already exist (and is not a symlink, including a dangling one).
      "tendcf_user_home_ok"
        expression => and(regcmp("/[^/].*", "$(home_dir)"),
                          not(regcmp("(^|.*/)\\.\\.?(/.*|$)", "$(home_dir)")));

      "tendcf_user_owner_ok"
        expression => and(regcmp("[a-z_][a-z0-9_-]*", "$(owner)"),
                          islessthan(string_length("$(owner)"), 33));

      "tendcf_user_library_dir_ok"
        expression => and(isdir("$(home_dir)/Library"),
                          not(islink("$(home_dir)/Library"))),
        ifvarclass => "tendcf_user_home_ok";

      "tendcf_user_launchagents_missing"
        expression => and(not(fileexists("$(home_dir)/Library/LaunchAgents")),
                          not(islink("$(home_dir)/Library/LaunchAgents"))),
        ifvarclass => "tendcf_user_home_ok";

  files:
      "$(home_dir)/Library/LaunchAgents/."
        create => "true",
        perms => tendcf_user_dir_perms("$(owner)"),
        ifvarclass => "darwin.!tendcf_cmdb_refused.tendcf_user_home_ok.tendcf_user_owner_ok.tendcf_user_library_dir_ok.tendcf_user_launchagents_missing";
}

bundle agent tendcf_services
{
  classes:
      # Fail-closed root/user privilege split (issue #94, operator ruling
      # 2026-11-23): `sys.user_data[uid|username|gid|home_dir]` comes from
      # getpwuid(getuid()), never from $HOME/$USER. Root actuates `system` only;
      # non-root actuates `user` only.
      "tendcf_running_as_root"
        expression => strcmp("$(sys.user_data[uid])", "0");

      "tendcf_running_as_nonroot"
        expression => regcmp("[1-9][0-9]*", "$(sys.user_data[uid])");

      # Validate sys.user_data[home_dir] before constructing
      # `$(sys.user_data[home_dir])/Library/LaunchAgents`: reject empty, `/`,
      # `//...`, or any `.` / `..` path component so a malformed passwd entry
      # can never alias system-wide `/Library/LaunchAgents`.
      "tendcf_user_home_valid"
        expression => and(isvariable("sys.user_data[home_dir]"),
                          regcmp("/[^/].*", "$(sys.user_data[home_dir])"),
                          not(regcmp("(^|.*/)\\.\\.?(/.*|$)", "$(sys.user_data[home_dir])")));

  methods:
      # Production entry point: binds the launchd adapter to its fixed system
      # or user paths, domain, and identity. No goal file, CMDB projection
      # (host_specific.json), augments file (def.json), environment variable or
      # -D class can override them. Only a separate policy file
      # (tests/policy/run.sh's non-root harness) that calls
      # tendcf_services_apply(...) directly can supply scratch paths.
      "services_system"
        usebundle => tendcf_services_apply("system",
                                           "/Library/LaunchDaemons",
                                           "/bin/launchctl",
                                           "root",
                                           "wheel",
                                           "root",
                                           "0"),
        action => tendcf_probe_always,
        ifvarclass => "!tendcf_cmdb_refused.tendcf_running_as_root";

      # Runs to completion before `services_user_darwin` enters
      # tendcf_services_apply, so a freshly created ~/Library/LaunchAgents is
      # visible to pass-1 isdir("$(launchd_dir)"). Symlinks and regular files
      # at ~/Library/LaunchAgents are never touched and fail closed downstream.
      "ensure_user_launchagents"
        usebundle => tendcf_ensure_user_launchagents("$(sys.user_data[home_dir])",
                                                     "$(sys.user_data[username])"),
        action => tendcf_probe_always,
        ifvarclass => "darwin.!tendcf_cmdb_refused.tendcf_running_as_nonroot.!tendcf_running_as_root.tendcf_user_home_valid";

      "services_user_darwin"
        usebundle => tendcf_services_apply("user",
                                           "$(sys.user_data[home_dir])/Library/LaunchAgents",
                                           "/bin/launchctl",
                                           "$(sys.user_data[username])",
                                           "$(sys.user_data[gid])",
                                           "$(sys.user_data[username])",
                                           "$(sys.user_data[uid])"),
        action => tendcf_probe_always,
        ifvarclass => "darwin.!tendcf_cmdb_refused.tendcf_running_as_nonroot.!tendcf_running_as_root.tendcf_user_home_valid";

      # Non-Darwin non-root runs (e.g. Linux CI flavour/host checks) do not
      # depend on sys.user_data[home_dir]; launchd_dir is unused off Darwin.
      "services_user_nondarwin"
        usebundle => tendcf_services_apply("user",
                                           "",
                                           "/bin/launchctl",
                                           "$(sys.user_data[username])",
                                           "$(sys.user_data[gid])",
                                           "$(sys.user_data[username])",
                                           "$(sys.user_data[uid])"),
        action => tendcf_probe_always,
        ifvarclass => "!darwin.!tendcf_cmdb_refused.tendcf_running_as_nonroot.!tendcf_running_as_root";

  reports:
      "!tendcf_cmdb_refused.!tendcf_running_as_root.!tendcf_running_as_nonroot"::
        "tendcf: service actuation refused: sys.user_data[uid] is unavailable or invalid; refusing all service actuation";

      "darwin.!tendcf_cmdb_refused.tendcf_running_as_nonroot.!tendcf_running_as_root.!tendcf_user_home_valid"::
        "tendcf: service actuation refused: sys.user_data[home_dir] is unavailable or invalid for non-root launchd user domain; refusing all service actuation";
}

# Note: `launchd_group` is applied only in system mode (`tendcf_plist_perms`).
# In user mode, `tendcf_user_plist_perms` intentionally omits `groups` because
# non-root users cannot chgrp arbitrary BSD-inherited groups and
# `sys.user_data[gid]` is numeric.
bundle agent tendcf_services_apply(launchd_domain, launchd_dir, launchctl_bin, launchd_owner, launchd_group, launchd_run_user, launchd_uid)
{
  vars:
      # Empty under a CMDB mismatch, see tendcf_interlocks and `tendcf_cmdb`
      # (set explicitly for the same reason as there, so even a direct call to
      # tendcf_services_apply fails closed under tendcf_cmdb_refused).
      "service_ids"
        slist => getindices("data:variables.tendcf_service"),
        ifvarclass => "!tendcf_cmdb_refused";

      "service_ids"
        slist => { },
        ifvarclass => "tendcf_cmdb_refused";

      "interlock_ids"
        slist => getindices("data:variables.tendcf_interlock"),
        ifvarclass => "!tendcf_cmdb_refused";

      "interlock_ids"
        slist => { },
        ifvarclass => "tendcf_cmdb_refused";

      "service_canon[$(service_ids)]"
        string => canonify("$(service_ids)");

      "service_lower[$(service_ids)]"
        string => string_downcase("$(service_ids)");

      "interlock_canon[$(interlock_ids)]"
        string => canonify("$(interlock_ids)");

      "service_bundle_canon[$(service_ids)]"
        string => canonify(
          "$(data:variables.tendcf_service[$(service_ids)][bundle])");

      "interlock_bundle_canon[$(interlock_ids)]"
        string => canonify(
          "$(data:variables.tendcf_interlock[$(interlock_ids)][bundle])");

      # The goal file's `unit` carries exactly one flavour key (goal-file
      # schema $defs/unit, oneOf launchd/systemd/runit); a tombstone
      # ({"state": "absent"}) carries none, so this is "" for it.
      "unit_flavours[$(service_ids)]"
        slist => getindices("data:variables.tendcf_service[$(service_ids)][unit]");

      "unit_flavour[$(service_ids)]"
        string => join(",", "unit_flavours[$(service_ids)]");

      "service_launchd_domain[$(service_ids)]"
        string => "$(data:variables.tendcf_service[$(service_ids)][unit][launchd][domain])",
        ifvarclass => isvariable("data:variables.tendcf_service[$(service_ids)][unit][launchd][domain]");

      # Per-service launchctl target domain, peer domain (user mode anti-dual-load),
      # and effective-domain reload-pending key. Resolved in pass 1 from literal
      # bundle parameters and service_launchd_domain.
      "service_launchd_target[$(service_ids)]"
        string => "system",
        ifvarclass => and(strcmp("$(launchd_domain)", "system"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "system"));

      "service_launchd_target[$(service_ids)]"
        string => "gui/$(launchd_uid)",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-gui"));

      "service_launchd_target[$(service_ids)]"
        string => "user/$(launchd_uid)",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-background"));

      "service_launchd_peer[$(service_ids)]"
        string => "user/$(launchd_uid)",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-gui"));

      "service_launchd_peer[$(service_ids)]"
        string => "gui/$(launchd_uid)",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-background"));

      "service_launchd_reload_key[$(service_ids)]"
        string => "system",
        ifvarclass => and(strcmp("$(launchd_domain)", "system"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "system"));

      "service_launchd_reload_key[$(service_ids)]"
        string => "user_gui",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-gui"));

      "service_launchd_reload_key[$(service_ids)]"
        string => "user_background",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-background"));

      "service_launchd_peer_reload_key[$(service_ids)]"
        string => "user_background",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-gui"));

      "service_launchd_peer_reload_key[$(service_ids)]"
        string => "user_gui",
        ifvarclass => and(strcmp("$(launchd_domain)", "user"),
                          regcmp("[1-9][0-9]*", "$(launchd_uid)"),
                          isvariable("service_launchd_domain[$(service_ids)]"),
                          strcmp("$(service_launchd_domain[$(service_ids)])", "user-background"));

      "service_run_as[$(service_ids)]"
        string => "$(data:variables.tendcf_service[$(service_ids)][run_as])",
        ifvarclass => isvariable("data:variables.tendcf_service[$(service_ids)][run_as]");

      "service_run_as_display[$(service_ids)]"
        string => "$(service_run_as[$(service_ids)])",
        ifvarclass => isvariable("service_run_as[$(service_ids)]");

      "service_run_as_display[$(service_ids)]"
        string => "<missing>",
        ifvarclass => not(isvariable("data:variables.tendcf_service[$(service_ids)][run_as]"));

      # Collision detection across service_ids (H1 / Adversary #1): the schema
      # admits '.', '-', '_' and '@', all of which canonify() maps to '_'.
      # Two colliding ids would share every sticky per-service class; on darwin
      # (case-insensitive APFS), two ids differing only in ASCII case also
      # collide on disk. Detect both and fail closed on all service actuation.
      "service_canon_list"
        slist => maplist(canonify("$(this)"), "service_ids"),
        ifvarclass => isgreaterthan(length("service_ids"), 0);

      "service_canon_list"
        slist => { },
        ifvarclass => not(isgreaterthan(length("service_ids"), 0));

      "service_canon_unique"
        slist => unique("service_canon_list"),
        ifvarclass => isgreaterthan(length("service_ids"), 0);

      "service_canon_unique"
        slist => { },
        ifvarclass => not(isgreaterthan(length("service_ids"), 0));

      "service_lower_list"
        slist => maplist(string_downcase("$(this)"), "service_ids"),
        ifvarclass => and("darwin", isgreaterthan(length("service_ids"), 0));

      "service_lower_list"
        slist => { },
        ifvarclass => not(and("darwin", isgreaterthan(length("service_ids"), 0)));

      "service_lower_unique"
        slist => unique("service_lower_list"),
        ifvarclass => and("darwin", isgreaterthan(length("service_ids"), 0));

      "service_lower_unique"
        slist => { },
        ifvarclass => not(and("darwin", isgreaterthan(length("service_ids"), 0)));

      # Exact on-disk entry names in $(launchd_dir) (readdir preserves case on
      # case-insensitive APFS). Used to require an exact-case filename match
      # before a tombstone boots out or deletes a plist.
      "launchd_dir_entries"
        slist => lsdir("$(launchd_dir)", ".*", "false"),
        ifvarclass => and("darwin",
                          regcmp("/.*", "$(launchd_dir)"),
                          isdir("$(launchd_dir)"),
                          not(islink("$(launchd_dir)")));

      "launchd_dir_entries"
        slist => { },
        ifvarclass => not(and("darwin",
                              regcmp("/.*", "$(launchd_dir)"),
                              isdir("$(launchd_dir)"),
                              not(islink("$(launchd_dir)"))));

      "service_plist_exact_re[$(service_ids)]"
        string => concat("^", escape("$(service_ids).plist"), "$");

  classes:
      # Fail-closed service-id collision guards (must precede every actuation
      # and probe class below).
      "tendcf_service_id_canon_collision"
        expression => and(isgreaterthan(length("service_ids"), 0),
                          isgreaterthan(length("service_ids"), length("service_canon_unique")));

      "tendcf_service_id_case_collision"
        expression => and("darwin",
                          isgreaterthan(length("service_ids"), 0),
                          isgreaterthan(length("service_ids"), length("service_lower_unique")));

      "tendcf_service_id_collision"
        expression => "tendcf_service_id_canon_collision|tendcf_service_id_case_collision";

      # state dispatch -- the one place this bundle inspects an entry's
      # value to pick a promise, which C-1 says belongs here and nowhere
      # upstream of it.
      #
      # Per-service class naming (Adversary M1): every per-service class puts
      # its fixed semantic tag FIRST, terminated by `__`, with
      # `$(service_canon[$(service_ids)])` LAST. No fixed tag contains `__`, so
      # splitting on the first `__` uniquely identifies (tag, service_canon)
      # and two distinct canonical IDs (e.g. `com.x.a` vs `com.x.a.launchd`)
      # can never alias on any class name.
      "tendcf_svc_present__$(service_canon[$(service_ids)])"
        expression => strcmp("$(data:variables.tendcf_service[$(service_ids)][state])",
                              "present");

      "tendcf_svc_absent__$(service_canon[$(service_ids)])"
        expression => strcmp("$(data:variables.tendcf_service[$(service_ids)][state])",
                              "absent");

      # Defence-in-depth guard (issue #102): refuse and report any attempt to
      # actuate or tombstone tendcf's own installer-owned scheduler unit even
      # if a projection bypassed lint/compiler. Matched case-insensitively for
      # launchd (`org.tendcf.execd`) to protect case-insensitive APFS, and
      # exactly for systemd (`tendcf-execd.service`, suffixless `tendcf-execd`
      # which systemctl implicitly resolves to `.service`, and same-stem
      # companion units `.timer`/`.socket`/`.path`), unconditionally across
      # all platforms and launchd domains.
      "tendcf_svc_reserved__$(service_canon[$(service_ids)])"
        expression => or(strcmp("$(service_lower[$(service_ids)])", "org.tendcf.execd"),
                         strcmp("$(service_ids)", "tendcf-execd.service"),
                         strcmp("$(service_ids)", "tendcf-execd"),
                         strcmp("$(service_ids)", "tendcf-execd.timer"),
                         strcmp("$(service_ids)", "tendcf-execd.socket"),
                         strcmp("$(service_ids)", "tendcf-execd.path"));

      # Bundle-scoped blast radius: named by the interlock's OWN bundle
      # tag, not by which service references it, so N interlocks sharing
      # one tag OR together with no join against the service list.
      # interlock_ok_* is final here: tendcf_interlocks ran to completion
      # before this bundle started (see the header).
      "interlock_blocked_$(interlock_bundle_canon[$(interlock_ids)])"
        expression => "!interlock_ok_$(interlock_canon[$(interlock_ids)])";

      # Fail-closed flavour/host guard (linux-targets.md step 3). Two
      # adapters exist, each tied to the host that can run it: launchd on
      # darwin, systemd on a Linux host booted by systemd. A present entry
      # is actuated only when its flavour AND its host both match; anything
      # else is refused and reported, never rendered through the wrong
      # adapter (a systemd entry would otherwise become a LaunchDaemons
      # plist, and a launchd entry on Linux would be written to /Library
      # and handed to a launchctl that is not there). A later adapter adds
      # its own `tendcf_svc_*_supported__*` disjunct; nothing here is removed.
      #
      # launchd host guard: darwin with valid domain/identity parameters, an
      # absolute, real (non-symlink) directory (never system-wide
      # `/Library/LaunchAgents` or `/Library/LaunchDaemons` in user mode) and
      # an absolute, executable launchctl binary. Operand order is load-bearing
      # (same reason as systemd below).
      "tendcf_launchd_mode_system"
        expression => strcmp("$(launchd_domain)", "system");

      "tendcf_launchd_mode_user"
        expression => strcmp("$(launchd_domain)", "user");

      "tendcf_launchd_uid_valid_user"
        expression => regcmp("[1-9][0-9]*", "$(launchd_uid)");

      "tendcf_launchd_run_user_valid"
        expression => and(regcmp("[a-z_][a-z0-9_-]*", "$(launchd_run_user)"),
                          islessthan(string_length("$(launchd_run_user)"), 33));

      "tendcf_launchd_dir_is_system_agents"
        expression => regcmp("(?i)/+(\\./+)*(System/+)?Library/+Launch(Agents|Daemons)(/+|\\.)*", "$(launchd_dir)");

      "tendcf_launchd_mode_valid"
        expression => "tendcf_launchd_mode_system|(tendcf_launchd_mode_user.tendcf_launchd_uid_valid_user.tendcf_launchd_run_user_valid.!tendcf_launchd_dir_is_system_agents)";

      "tendcf_launchd_dir_abs"
        expression => regcmp("/.*", "$(launchd_dir)");

      "tendcf_launchd_dir_ok"
        expression => isdir("$(launchd_dir)");

      "tendcf_launchd_dir_link"
        expression => islink("$(launchd_dir)");

      "tendcf_launchctl_abs"
        expression => regcmp("/.*", "$(launchctl_bin)");

      "tendcf_launchctl_exec"
        expression => isexecutable("$(launchctl_bin)");

      "tendcf_launchd_host"
        expression => "darwin.tendcf_launchd_mode_valid.tendcf_launchd_dir_abs.tendcf_launchd_dir_ok.!tendcf_launchd_dir_link.tendcf_launchctl_abs.tendcf_launchctl_exec";

      # "Booted by systemd" is sd_booted(3): /run/systemd/system is a
      # directory. A Linux container or chroot without it has a systemctl
      # binary that cannot reach a manager, so it counts as no host.
      "tendcf_systemd_booted"
        expression => isdir("/run/systemd/system");

      # The adapter writes /etc/systemd/system. On NixOS that path is a
      # symlink into the read-only store (/etc/static/systemd/system): a
      # unit exists there only if the Nix configuration declares it, and
      # the host's supervisor is `nixos`, never cfengine
      # (linux-targets.md section 5, nixos-passthrough-plan.md section 2).
      # Refuse by policy rather than half-fail on the write: a real,
      # non-symlink directory is required.
      #
      # Operand order is load-bearing (same reason as the header): a class
      # expression naming a class not yet defined reads it as false, and a
      # class once set is never re-evaluated. With `_writable` above its
      # operands, pass 1 set `_elsewhere` on every normal systemd host and
      # every present entry was reported "refused" while it was rendered in
      # pass 2 (seen in CI, 2026-11-01; present since the guard landed).
      "tendcf_systemd_units_dir"
        expression => isdir("/etc/systemd/system");

      "tendcf_systemd_units_link"
        expression => islink("/etc/systemd/system");

      "tendcf_systemd_units_writable"
        expression => "tendcf_systemd_units_dir.!tendcf_systemd_units_link";

      "tendcf_systemd_units_elsewhere"
        expression => "linux.tendcf_systemd_booted.!tendcf_systemd_units_writable";

      "tendcf_systemd_host"
        expression => "linux.tendcf_systemd_booted.tendcf_systemd_units_writable";

      # Re-enforce the schema's service-id alphabet (goal-file.schema.json
      # $defs/service_map propertyNames: ^[A-Za-z0-9][A-Za-z0-9@._-]*$, <=128)
      # on the launchd path so a projection that skipped the schema cannot
      # traverse out of launchd_dir (via `/`) or inject spaces/quotes into
      # the returnszero() probe command string.
      "tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)])"
        expression => and(regcmp("[A-Za-z0-9][A-Za-z0-9@._-]*", "$(service_ids)"),
                          islessthan(string_length("$(service_ids)"), 129));

      # Re-enforce the schema's systemd service-id alphabet (issue #102 R1/R3):
      # require a single filename with leading alphanumeric, allowed
      # `[A-Za-z0-9@._-]` characters only (no `/`, no whitespace), no
      # embedded/trailing newline, and length <= 128 so an unvalidated
      # projection cannot traverse out of /etc/systemd/system (e.g.
      # `./tendcf-execd.service`, `../system/tendcf-execd.service`,
      # `tendcf-execd.service.d/override.conf`) or inject arguments into
      # returnszero("/usr/bin/systemctl ... $(service_ids)").
      # Present systemd services require `.service` (systemd.service.mustache
      # renders `.service` units only); tombstones admit all four schema unit
      # suffixes (`.service`, `.socket`, `.timer`, `.path`). Embedded `..`
      # inside a single filename (e.g. `backup..daily.service`) is safe and
      # allowed because `/` is forbidden and leading `.` is disallowed.
      "tendcf_svc_systemd_id_valid__$(service_canon[$(service_ids)])"
        expression => and(regcmp("[A-Za-z0-9][A-Za-z0-9@._-]*\\.service", "$(service_ids)"),
                          not(regcmp("(?s).*\\n.*", "$(service_ids)")),
                          islessthan(string_length("$(service_ids)"), 129));

      "tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)])"
        expression => and(regcmp("[A-Za-z0-9][A-Za-z0-9@._-]*\\.(service|socket|timer|path)", "$(service_ids)"),
                          not(regcmp("(?s).*\\n.*", "$(service_ids)")),
                          islessthan(string_length("$(service_ids)"), 129));

      "tendcf_svc_launchd__$(service_canon[$(service_ids)])"
        expression => strcmp("$(unit_flavour[$(service_ids)])", "launchd");

      "tendcf_svc_launchd_dom_system__$(service_canon[$(service_ids)])"
        expression => strcmp("$(service_launchd_domain[$(service_ids)])", "system"),
        ifvarclass => isvariable("service_launchd_domain[$(service_ids)]");

      "tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)])"
        expression => strcmp("$(service_launchd_domain[$(service_ids)])", "user-gui"),
        ifvarclass => isvariable("service_launchd_domain[$(service_ids)]");

      "tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)])"
        expression => strcmp("$(service_launchd_domain[$(service_ids)])", "user-background"),
        ifvarclass => isvariable("service_launchd_domain[$(service_ids)]");

      "tendcf_svc_launchd_domain_valid__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd_dom_system__$(service_canon[$(service_ids)])|tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)])|tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_domain_match__$(service_canon[$(service_ids)])"
        expression => "(tendcf_launchd_mode_system.tendcf_svc_launchd_dom_system__$(service_canon[$(service_ids)]))|(tendcf_launchd_mode_user.(tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)])|tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)])))";

      # Q1 cross-domain informational skip (issue #103, operator ruling
      # 2026-11-24): a valid launchd entry targeting the opposite privilege
      # tier is skipped informationally (NOT refused) with zero file writes
      # and zero launchctl calls. Invalid/missing/stale-v8 `"user"` domains
      # and mismatched `run_as` in the active tier stay refused.
      "tendcf_svc_launchd_domain_skipped__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_launchd__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).tendcf_launchd_host.tendcf_svc_launchd_domain_valid__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_domain_match__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      # Re-enforce the schema's run_as alphabet (`^[a-z_][a-z0-9_-]*$`, <=32)
      # in both system and user modes so an unvalidated projection cannot omit
      # or corrupt UserName in system mode; user mode additionally requires an
      # exact match with the running user.
      "tendcf_svc_launchd_run_as_valid__$(service_canon[$(service_ids)])"
        expression => and(isvariable("data:variables.tendcf_service[$(service_ids)][run_as]"),
                          regcmp("[a-z_][a-z0-9_-]*", "$(service_run_as[$(service_ids)])"),
                          islessthan(string_length("$(service_run_as[$(service_ids)])"), 33)),
        ifvarclass => isvariable("service_run_as[$(service_ids)]");

      "tendcf_svc_launchd_run_as_match__$(service_canon[$(service_ids)])"
        expression => strcmp("$(service_run_as[$(service_ids)])", "$(launchd_run_user)"),
        ifvarclass => isvariable("service_run_as[$(service_ids)]");

      "tendcf_svc_launchd_run_as_ok__$(service_canon[$(service_ids)])"
        expression => "(tendcf_launchd_mode_system.tendcf_svc_launchd_run_as_valid__$(service_canon[$(service_ids)]))|(tendcf_launchd_mode_user.tendcf_launchd_run_user_valid.tendcf_svc_launchd_run_as_valid__$(service_canon[$(service_ids)]).tendcf_svc_launchd_run_as_match__$(service_canon[$(service_ids)]))";

      "tendcf_svc_systemd__$(service_canon[$(service_ids)])"
        expression => strcmp("$(unit_flavour[$(service_ids)])", "systemd");

      "tendcf_svc_launchd_supported__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).tendcf_launchd_host.tendcf_svc_launchd_domain_match__$(service_canon[$(service_ids)]).tendcf_svc_launchd_run_as_ok__$(service_canon[$(service_ids)]).!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      "tendcf_svc_systemd_supported__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_systemd__$(service_canon[$(service_ids)]).tendcf_svc_systemd_id_valid__$(service_canon[$(service_ids)]).tendcf_systemd_host.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      "tendcf_svc_supported__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd_supported__$(service_canon[$(service_ids)])|tendcf_svc_systemd_supported__$(service_canon[$(service_ids)])";

      "tendcf_svc_refused__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_present__$(service_canon[$(service_ids)]).!tendcf_svc_supported__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_domain_skipped__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      # A tombstone has no unit, so it has no flavour and `tendcf_svc_refused`
      # (which needs `tendcf_svc_present`) cannot see it. Where the units are
      # the system configuration's, a tombstone is reported and never actuated
      # (D3).
      "tendcf_svc_tombstone_elsewhere__$(service_canon[$(service_ids)])"
        expression => "tendcf_systemd_units_elsewhere.tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      # launchd path-type snapshot (C-policy-04, plus symlink safety on
      # present): `isplain` is true only for a regular file and does not
      # follow symlinks. Evaluated only on a valid launchd host and valid id
      # when no service-id collision is present.
      "tendcf_svc_plist_plain__$(service_canon[$(service_ids)])"
        expression => isplain("$(launchd_dir)/$(service_ids).plist"),
        ifvarclass => "tendcf_launchd_host.tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      "tendcf_svc_plist_exists__$(service_canon[$(service_ids)])"
        expression => fileexists("$(launchd_dir)/$(service_ids).plist"),
        ifvarclass => "tendcf_launchd_host.tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      "tendcf_svc_plist_linked__$(service_canon[$(service_ids)])"
        expression => islink("$(launchd_dir)/$(service_ids).plist"),
        ifvarclass => "tendcf_launchd_host.tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      "tendcf_svc_plist_nonregular__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_host.tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).(tendcf_svc_plist_exists__$(service_canon[$(service_ids)])|tendcf_svc_plist_linked__$(service_canon[$(service_ids)])).!tendcf_svc_plist_plain__$(service_canon[$(service_ids)])";

      # Exact-case directory entry check on case-insensitive APFS (H1 / Adversary
      # Blocker #2): readdir (`lsdir`) preserves on-disk case, so both present
      # renders and tombstones refuse a differently-cased regular plist on disk
      # (preventing overwriting or bootstrapping an un-tombstoneable job, or
      # deleting a differently-cased plist). `!plist_changed.!plist_ready` keeps
      # Pass 2/3 from false-triggering on a brand-new plist created during this
      # run (after Pass-1 `lsdir`).
      "tendcf_svc_plist_exact_case__$(service_canon[$(service_ids)])"
        expression => reglist("launchd_dir_entries", "$(service_plist_exact_re[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_host.tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).tendcf_svc_plist_plain__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      "tendcf_svc_plist_case_mismatch__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_host.tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_plist_plain__$(service_canon[$(service_ids)]).!tendcf_svc_plist_nonregular__$(service_canon[$(service_ids)]).!tendcf_svc_plist_exact_case__$(service_canon[$(service_ids)]).!tendcf_svc_plist_changed__$(service_canon[$(service_ids)]).!tendcf_svc_plist_ready__$(service_canon[$(service_ids)])";

      # launchd present actuation gate: flavour+host+id match, no id collision,
      # interlock bundle met, and target path is either absent or an exact-case
      # regular file (never a symlink, directory, or case-mismatched APFS file).
      "tendcf_svc_launchd_go__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd_supported__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).!interlock_blocked_$(service_bundle_canon[$(service_ids)]).!tendcf_svc_plist_nonregular__$(service_canon[$(service_ids)]).!tendcf_svc_plist_case_mismatch__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_present_nonregular__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd_supported__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).!interlock_blocked_$(service_bundle_canon[$(service_ids)]).tendcf_svc_plist_nonregular__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_present_case_mismatch__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd_supported__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).!interlock_blocked_$(service_bundle_canon[$(service_ids)]).tendcf_svc_plist_case_mismatch__$(service_canon[$(service_ids)])";

      # launchd tombstone gate (C-policy-04): explicit state == "absent",
      # !present, no id collision, valid label id, regular plist file at
      # launchd_dir/<id>.plist, and exact-case entry match in launchd_dir.
      # Symlinks (Homebrew, nix-darwin, vendor links), dangling links and
      # directories are refused and reported with no launchctl call; absent
      # paths are a silent no-op. Same caveat as systemd below: `isplain` does
      # not prove tendcf wrote the regular file; unit-writer prefix ownership
      # is checked by lint/validator before projection.
      "tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_plist_plain__$(service_canon[$(service_ids)]).!tendcf_svc_plist_nonregular__$(service_canon[$(service_ids)]).tendcf_svc_plist_exact_case__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_tombstone_case_mismatch__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_plist_plain__$(service_canon[$(service_ids)]).!tendcf_svc_plist_nonregular__$(service_canon[$(service_ids)]).!tendcf_svc_plist_exact_case__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_teardown_refused__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_plist_nonregular__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_tombstone_bad_id__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_tombstone_host_refused__$(service_canon[$(service_ids)])"
        expression => "darwin.!tendcf_launchd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)])";

      # User-mode domain-level probe trigger (issue #103): run `print gui/<uid>`
      # and `print user/<uid>` at most once per run, and ONLY when at least one
      # user-mode present service or regular exact-case user tombstone needs
      # evaluation (zero launchctl calls when every entry is skipped, refused,
      # reserved, or an already-absent tombstone).
      "tendcf_launchd_user_needs_domain_probes"
        expression => "tendcf_launchd_host.tendcf_launchd_mode_user.!tendcf_cmdb_refused.!tendcf_service_id_collision.(tendcf_svc_launchd_go__$(service_canon[$(service_ids)])|tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]))";

      # Pass-2 domain-probe verdict summaries (set after Pass-1 commands 0a/0b).
      # Operand order is load-bearing: peer_failed/peer_ready precede deferred
      # and loaded so Pass 2 sees Pass-1 peer outcomes before computing them.
      "tendcf_launchd_user_domain_probes_ok"
        expression => "(tendcf_launchd_gui_available|tendcf_launchd_gui_absent).(tendcf_launchd_user_available|tendcf_launchd_user_absent).!tendcf_launchd_gui_probe_failed.!tendcf_launchd_user_probe_failed";

      # Peer domain is clear when there is no peer (system mode) or when the
      # peer domain was proved absent by the domain-level probe (Pass-1 peer
      # commands also define this class when print returns 113/3 or bootout 0).
      "tendcf_svc_launchd_peer_clear__$(service_canon[$(service_ids)])"
        expression => "(tendcf_launchd_mode_system.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]))|(tendcf_launchd_mode_user.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]).tendcf_launchd_user_domain_probes_ok.((tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)]).tendcf_launchd_user_absent)|(tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)]).tendcf_launchd_gui_absent)))";

      "tendcf_svc_launchd_peer_failed__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd_peer_probe_failed__$(service_canon[$(service_ids)])|tendcf_svc_launchd_peer_bootout_failed__$(service_canon[$(service_ids)])";

      "tendcf_svc_launchd_peer_ready__$(service_canon[$(service_ids)])"
        expression => "(tendcf_svc_launchd_peer_clear__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_peer_failed__$(service_canon[$(service_ids)]))|(opt_dry_run.tendcf_svc_launchd_peer_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_peer_probe_failed__$(service_canon[$(service_ids)]))";

      "tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)])"
        expression => "(tendcf_launchd_mode_system.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]))|(tendcf_launchd_mode_user.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]).tendcf_launchd_user_domain_probes_ok.((tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)]).tendcf_launchd_gui_available)|tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)])))";

      "tendcf_svc_launchd_deferred__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_mode_user.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]).tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)]).tendcf_launchd_user_domain_probes_ok.tendcf_launchd_gui_absent.!tendcf_svc_launchd_peer_failed__$(service_canon[$(service_ids)])";

      # User-mode tombstone absent-domain legs (Pass 2): an absent domain cannot
      # host a running job, so that leg is clear with zero per-service probes.
      "tendcf_svc_tomb_gui_clear__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_launchd_gui_absent.!tendcf_launchd_gui_probe_failed";

      "tendcf_svc_tomb_user_clear__$(service_canon[$(service_ids)])"
        expression => "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_launchd_user_absent.!tendcf_launchd_user_probe_failed";

      # Pre-run snapshot of whether launchd has this PRESENT label loaded in
      # its target domain (`system`, `gui/<uid>`, or `user/<uid>`; C-policy-03,
      # issues #94, #103). Evaluated in pass 1 for system mode and pass 2 for
      # user mode (only after domain availability probes prove the target
      # domain is available and peer domain is ready, so headless runs and
      # failed peer sweeps never waste a target `launchctl print`).
      # Tombstones do NOT use returnszero(); they run dedicated read-only
      # `commands:` probes below so non-113/3 IPC errors fail closed.
      "tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)])"
        expression => returnszero("$(launchctl_bin) print $(service_launchd_target[$(service_ids)])/$(service_ids)", "noshell"),
        ifvarclass => "tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).tendcf_svc_launchd_peer_ready__$(service_canon[$(service_ids)]).!tendcf_svc_reserved__$(service_canon[$(service_ids)]).(tendcf_launchd_mode_system|(tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)]).tendcf_launchd_gui_available)|(tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)]).tendcf_launchd_user_available))";

      # Persistent reload-pending marker (M1, scoped per effective domain:
      # `system`, `user_gui`, `user_background`): if a loaded plist was
      # repaired but bootstrap did not complete (e.g. bootout failed or was
      # lock-skipped), persist a namespace class across runs (24 h TTL) so the
      # next run retries bootout+bootstrap even when the plist on disk is now
      # unchanged. Cancelled on successful bootstrap, peer bootout, or
      # tombstone teardown.
      "tendcf_launchd_$(service_launchd_reload_key[$(service_ids)])_reload_pending__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)]).tendcf_svc_plist_changed__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_bootstrapped__$(service_canon[$(service_ids)]).!opt_dry_run",
        ifvarclass => isvariable("service_launchd_reload_key[$(service_ids)]"),
        scope => "namespace",
        persistence => "1440";

      # systemd actuation gate: the entry's own interlock bundle is met and no
      # service-id collision is present.
      "tendcf_svc_systemd_go__$(service_canon[$(service_ids)])"
        expression => "tendcf_svc_systemd_supported__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).!interlock_blocked_$(service_bundle_canon[$(service_ids)])";

      # `enabled` is the boot symlink (systemctl enable/disable); a present
      # service is started either way, as launchd's bootstrap starts it when
      # RunAtLoad is true.
      "tendcf_svc_enabled__$(service_canon[$(service_ids)])"
        expression => strcmp("$(data:variables.tendcf_service[$(service_ids)][unit][systemd][enabled])", "true");

      # Pre-run snapshots of the manager's state. returnszero() results are
      # cached for the whole run (verified against the dev build), so these
      # keep the state from BEFORE any command below ran, which is what
      # lets one run converge without a second restart: a unit that was
      # inactive is started, not started and then restarted because pass 2
      # sees it active.
      "tendcf_svc_active__$(service_canon[$(service_ids)])"
        expression => returnszero("/usr/bin/systemctl is-active --quiet $(service_ids)", "noshell"),
        ifvarclass => "tendcf_svc_systemd_supported__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      "tendcf_svc_boot_enabled__$(service_canon[$(service_ids)])"
        expression => returnszero("/usr/bin/systemctl is-enabled --quiet $(service_ids)", "noshell"),
        ifvarclass => "tendcf_svc_systemd_supported__$(service_canon[$(service_ids)]).!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)])";

      # Tombstone on a systemd host: tear down only a REGULAR file of that
      # name, which is what this adapter renders. Anything else at the path
      # is not ours to remove: an alias or enable-created link (pastebin's
      # /etc/systemd/system/sshd.service is an unowned alias link), a mask
      # (link to /dev/null), a dangling link, a directory. `fileexists` is
      # true for every one of those, so it is not the test; `isplain` is
      # true only for a regular file and does not follow links (run against
      # a real cf-agent, 3.29.0a: a link to a regular file is not plain
      # either). Passing this guard does NOT prove cfengine rendered the
      # file: who wrote a regular file is the lint's job (a tombstone must
      # fall under a cfengine unit-writer prefix, schema_lint.py), and it
      # does not stop `systemctl disable` from touching other links of the
      # unit (schema-v5-dpkg-reconciliation-2026-11-02.md section 6, S0).
      # launchd labels and runit names fall through untouched.
      "tendcf_svc_unit_plain__$(service_canon[$(service_ids)])"
        expression => isplain("/etc/systemd/system/$(service_ids)"),
        ifvarclass => "tendcf_systemd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)])";

      # Something is at the path and it is not a regular file: refused and
      # reported below, nothing run. `islink` is read as well, so a link is
      # refused whatever fileexists says about its target.
      "tendcf_svc_unit_exists__$(service_canon[$(service_ids)])"
        expression => fileexists("/etc/systemd/system/$(service_ids)"),
        ifvarclass => "tendcf_systemd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)])";

      "tendcf_svc_unit_linked__$(service_canon[$(service_ids)])"
        expression => islink("/etc/systemd/system/$(service_ids)"),
        ifvarclass => "tendcf_systemd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)])";

      "tendcf_svc_teardown__$(service_canon[$(service_ids)])"
        expression => "tendcf_systemd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)]).tendcf_svc_unit_plain__$(service_canon[$(service_ids)])";

      "tendcf_svc_teardown_refused__$(service_canon[$(service_ids)])"
        expression => "tendcf_systemd_host.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)]).(tendcf_svc_unit_exists__$(service_canon[$(service_ids)])|tendcf_svc_unit_linked__$(service_canon[$(service_ids)])).!tendcf_svc_unit_plain__$(service_canon[$(service_ids)])";

      "tendcf_svc_systemd_tombstone_bad_id__$(service_canon[$(service_ids)])"
        expression => "linux.!tendcf_service_id_collision.!tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).!tendcf_svc_systemd_tombstone_id_valid__$(service_canon[$(service_ids)])";

  files:
      # launchd plist render (C-policy-05, C-policy-03, Neon MH2, issues #94, #103):
      # mode 0644, root:wheel in system mode and user-owned in user mode, no
      # `.cf-before-edit` backup left in the launchd directory. `create => "true"`
      # is deliberately omitted so RenderTemplateMustache renders in memory first
      # and creates the file only on success (never leaving a 0-byte plist if
      # rendering fails); VerifyFileLeaf still applies `perms` in the same pass.
      # `launchd_include_username` and `launchd_session_type` are injected via
      # the trailing literal `mergedata()` object so no untrusted service field
      # can spoof them:
      #   - `system`: `UserName` included, `LimitLoadToSessionType` omitted;
      #   - `user-gui`: `UserName` omitted, `LimitLoadToSessionType=Aqua`;
      #   - `user-background`: `UserName` omitted, `LimitLoadToSessionType=Background`.
      "$(launchd_dir)/$(service_ids).plist"
        perms => tendcf_plist_perms("$(launchd_owner)", "$(launchd_group)"),
        edit_defaults => tendcf_no_backup,
        edit_template => "$(this.promise_dirname)/templates/launchd.plist.mustache",
        template_method => "mustache",
        template_data => mergedata("data:variables.tendcf_service[$(service_ids)]",
                                    '{"id": "$(service_ids)", "launchd_include_username": true, "launchd_include_session_type": false, "launchd_session_type": ""}'),
        classes => tendcf_plist_rendered(
          "tendcf_svc_plist_changed__$(service_canon[$(service_ids)])",
          "tendcf_svc_plist_ready__$(service_canon[$(service_ids)])",
          "tendcf_svc_plist_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).tendcf_launchd_mode_system";

      "$(launchd_dir)/$(service_ids).plist"
        perms => tendcf_user_plist_perms("$(launchd_owner)"),
        edit_defaults => tendcf_no_backup,
        edit_template => "$(this.promise_dirname)/templates/launchd.plist.mustache",
        template_method => "mustache",
        template_data => mergedata("data:variables.tendcf_service[$(service_ids)]",
                                    '{"id": "$(service_ids)", "launchd_include_username": false, "launchd_include_session_type": true, "launchd_session_type": "Aqua"}'),
        classes => tendcf_plist_rendered(
          "tendcf_svc_plist_changed__$(service_canon[$(service_ids)])",
          "tendcf_svc_plist_ready__$(service_canon[$(service_ids)])",
          "tendcf_svc_plist_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).tendcf_svc_launchd_peer_ready__$(service_canon[$(service_ids)]).tendcf_launchd_mode_user.tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)])";

      "$(launchd_dir)/$(service_ids).plist"
        perms => tendcf_user_plist_perms("$(launchd_owner)"),
        edit_defaults => tendcf_no_backup,
        edit_template => "$(this.promise_dirname)/templates/launchd.plist.mustache",
        template_method => "mustache",
        template_data => mergedata("data:variables.tendcf_service[$(service_ids)]",
                                    '{"id": "$(service_ids)", "launchd_include_username": false, "launchd_include_session_type": true, "launchd_session_type": "Background"}'),
        classes => tendcf_plist_rendered(
          "tendcf_svc_plist_changed__$(service_canon[$(service_ids)])",
          "tendcf_svc_plist_ready__$(service_canon[$(service_ids)])",
          "tendcf_svc_plist_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).tendcf_svc_launchd_peer_ready__$(service_canon[$(service_ids)]).tendcf_launchd_mode_user.tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)])";

      "/etc/systemd/system/$(service_ids)"
        create => "true",
        perms => tendcf_unit_perms,
        edit_defaults => tendcf_no_backup,
        edit_template => "$(this.promise_dirname)/templates/systemd.service.mustache",
        template_method => "mustache",
        template_data => mergedata("data:variables.tendcf_service[$(service_ids)]",
                                    '{"id": "$(service_ids)"}'),
        classes => tendcf_unit_rendered("tendcf_svc_unit_changed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_svc_systemd_go__$(service_canon[$(service_ids)])";

      # launchd tombstone delete (C-policy-04, Adversary #2, Neon L6, issue #103):
      # gated on a regular, exact-case plist file (`tendcf_svc_launchd_teardown`).
      # System mode waits for pass 2 after `system/<label>` is confirmed unloaded
      # (113/3) or booted out (exit 0). User mode waits for pass 2 after BOTH
      # `gui/<uid>` AND `user/<uid>` legs are confirmed clear (domain absent,
      # unloaded 113/3, or booted out exit 0) with zero domain or leg failures.
      "$(launchd_dir)/$(service_ids).plist"
        delete => tendcf_file_delete,
        classes => tendcf_launchd_delete(
          "tendcf_svc_launchd_delete_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_system_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_system.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).(tendcf_svc_tombstone_unloaded__$(service_canon[$(service_ids)])|tendcf_svc_launchd_torn_down__$(service_canon[$(service_ids)])).!tendcf_svc_tombstone_probe_failed__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_teardown_failed__$(service_canon[$(service_ids)])";

      "$(launchd_dir)/$(service_ids).plist"
        delete => tendcf_file_delete,
        classes => tendcf_launchd_delete2(
          "tendcf_svc_launchd_delete_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_user_gui_reload_pending__$(service_canon[$(service_ids)])",
          "tendcf_launchd_user_background_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_launchd_user_domain_probes_ok.tendcf_svc_tomb_gui_clear__$(service_canon[$(service_ids)]).tendcf_svc_tomb_user_clear__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_gui_probe_failed__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_gui_bootout_failed__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_user_probe_failed__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_user_bootout_failed__$(service_canon[$(service_ids)])";

      # Removal waits for the teardown command below (pass 2), because
      # `systemctl disable` needs the unit file still in place.
      "/etc/systemd/system/$(service_ids)"
        delete => tendcf_tidy,
        classes => tendcf_unit_removed,
        ifvarclass => "tendcf_svc_torn_down__$(service_canon[$(service_ids)])";

  commands:
      # 0a/0b. Once-per-run user-mode domain availability probes (issue #103):
      #        run at the top of commands: in Pass 1 so peer sweeps, tombstone
      #        sweeps, and Pass-2 files:/commands: all see the exact domain
      #        state in a single cf-agent invocation. Gated directly on
      #        tendcf_launchd_host, tendcf_launchd_mode_user, !tendcf_cmdb_refused,
      #        and !tendcf_service_id_collision (non-iterating promises are not
      #        auto-skipped when service_ids is empty), and action =>
      #        tendcf_probe_always (`ifelapsed => "0"`) so consecutive runs
      #        without `-K` (production cf-execd) never lock-skip domain probes.
      "$(launchctl_bin)"
        arglist => { "print", "gui/$(launchd_uid)" },
        action => tendcf_probe_always,
        contain => tendcf_noshell_readonly,
        classes => tendcf_launchd_gui_domain_probe(
          "tendcf_launchd_gui_available",
          "tendcf_launchd_gui_absent",
          "tendcf_launchd_gui_probe_failed"),
        ifvarclass => "tendcf_launchd_host.tendcf_launchd_mode_user.!tendcf_cmdb_refused.!tendcf_service_id_collision.tendcf_launchd_user_needs_domain_probes.!tendcf_launchd_gui_available.!tendcf_launchd_gui_absent.!tendcf_launchd_gui_probe_failed";

      "$(launchctl_bin)"
        arglist => { "print", "user/$(launchd_uid)" },
        action => tendcf_probe_always,
        contain => tendcf_noshell_readonly,
        classes => tendcf_launchd_user_domain_probe(
          "tendcf_launchd_user_available",
          "tendcf_launchd_user_absent",
          "tendcf_launchd_user_probe_failed"),
        ifvarclass => "tendcf_launchd_host.tendcf_launchd_mode_user.!tendcf_cmdb_refused.!tendcf_service_id_collision.tendcf_launchd_user_needs_domain_probes.!tendcf_launchd_user_available.!tendcf_launchd_user_absent.!tendcf_launchd_user_probe_failed";

      # 0c/0d. Present-service peer-domain anti-dual-load sweep (user mode):
      #        when the peer domain is available, probe `<peer>/<label>` and
      #        bootout by service-target strictly before target rendering and
      #        bootstrap. Also runs for `user-gui` while headless (`gui_absent`
      #        + `user_available`) so a `user-background` -> `user-gui` switch
      #        stops the old background job immediately. Clears ONLY the peer
      #        domain's reload_pending marker (retaining any pending target
      #        reload until target bootstrap succeeds).
      "$(launchctl_bin)"
        arglist => { "print", "$(service_launchd_peer[$(service_ids)])/$(service_ids)" },
        action => tendcf_probe_always,
        contain => tendcf_noshell_readonly,
        classes => tendcf_launchd_tombstone_probe(
          "tendcf_svc_launchd_peer_loaded__$(service_canon[$(service_ids)])",
          "tendcf_svc_launchd_peer_clear__$(service_canon[$(service_ids)])",
          "tendcf_svc_launchd_peer_probe_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]).!tendcf_launchd_gui_probe_failed.!tendcf_launchd_user_probe_failed.(tendcf_launchd_gui_available|tendcf_launchd_gui_absent).(tendcf_launchd_user_available|tendcf_launchd_user_absent).((tendcf_svc_launchd_dom_user_gui__$(service_canon[$(service_ids)]).tendcf_launchd_user_available)|(tendcf_svc_launchd_dom_user_bg__$(service_canon[$(service_ids)]).tendcf_launchd_gui_available)).!tendcf_svc_launchd_peer_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_peer_clear__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_peer_probe_failed__$(service_canon[$(service_ids)])";

      "$(launchctl_bin)"
        arglist => { "bootout", "$(service_launchd_peer[$(service_ids)])/$(service_ids)" },
        contain => tendcf_noshell,
        classes => tendcf_launchd_cmd_clear(
          "tendcf_svc_launchd_peer_clear__$(service_canon[$(service_ids)])",
          "tendcf_svc_launchd_peer_bootout_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_$(service_launchd_peer_reload_key[$(service_ids)])_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]).tendcf_svc_launchd_peer_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_peer_clear__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_peer_probe_failed__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_peer_bootout_failed__$(service_canon[$(service_ids)])";

      # launchd (C-policy-03). The files section ran first in this pass, so a
      # rendered plist is on disk with 0644 and expected ownership before
      # launchd is called. Only exit 0 is treated as success (launchctl(1)
      # EXIT STATUS). Under `-n` (`opt_dry_run`), CFEngine emits WARN on a
      # file promise that would change (setting `tendcf_svc_plist_failed` via
      # SetPromiseOutcomeClasses); the `opt_dry_run` branch lets CFEngine
      # log `Would execute script ...` previews without executing launchctl,
      # while normal (`!opt_dry_run`) runs stay strictly fail-closed on
      # `tendcf_svc_plist_ready.!tendcf_svc_plist_failed` and peer clearance.
      #
      # 1. Reload on drift/repair (or persisted reload-pending): already loaded
      #    AND plist was repaired (or a prior reload did not finish) -> bootout
      #    <target>/<label> first; bootstrap below runs only if bootout exits 0.
      #    `!tendcf_svc_launchd_bootstrapped` keeps this safe even if
      #    cache_system_functions were disabled (L1).
      "$(launchctl_bin)"
        arglist => { "bootout", "$(service_launchd_target[$(service_ids)])/$(service_ids)" },
        contain => tendcf_noshell,
        classes => tendcf_launchd_cmd(
          "tendcf_svc_launchd_booted_out__$(service_canon[$(service_ids)])",
          "tendcf_svc_launchd_bootout_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).tendcf_svc_launchd_peer_ready__$(service_canon[$(service_ids)]).tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_booted_out__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_bootout_failed__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_bootstrapped__$(service_canon[$(service_ids)]).((!opt_dry_run.tendcf_svc_plist_ready__$(service_canon[$(service_ids)]).!tendcf_svc_plist_failed__$(service_canon[$(service_ids)]).(tendcf_svc_plist_changed__$(service_canon[$(service_ids)])|tendcf_launchd_$(service_launchd_reload_key[$(service_ids)])_reload_pending__$(service_canon[$(service_ids)])))|(opt_dry_run.(tendcf_svc_plist_failed__$(service_canon[$(service_ids)])|tendcf_launchd_$(service_launchd_reload_key[$(service_ids)])_reload_pending__$(service_canon[$(service_ids)]))))";

      # 2a/2b. Load: not loaded before the run, OR just booted out after a
      #        repair. When unchanged and loaded, neither condition holds and
      #        no write launchctl call runs. Clears persisted reload-pending
      #        markers on exit 0 (system clears system; user clears both
      #        user_gui and user_background).
      "$(launchctl_bin)"
        arglist => { "bootstrap", "$(service_launchd_target[$(service_ids)])", "$(launchd_dir)/$(service_ids).plist" },
        contain => tendcf_noshell,
        classes => tendcf_launchd_cmd_clear(
          "tendcf_svc_launchd_bootstrapped__$(service_canon[$(service_ids)])",
          "tendcf_svc_launchd_bootstrap_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_system_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_system.tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_bootstrapped__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_bootstrap_failed__$(service_canon[$(service_ids)]).((!opt_dry_run.tendcf_svc_plist_ready__$(service_canon[$(service_ids)]).!tendcf_svc_plist_failed__$(service_canon[$(service_ids)]).(!tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)])|tendcf_svc_launchd_booted_out__$(service_canon[$(service_ids)])))|(opt_dry_run.((!tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)]).(tendcf_svc_plist_ready__$(service_canon[$(service_ids)])|tendcf_svc_plist_failed__$(service_canon[$(service_ids)])))|(tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)]).(tendcf_svc_plist_failed__$(service_canon[$(service_ids)])|tendcf_launchd_system_reload_pending__$(service_canon[$(service_ids)]))))))";

      "$(launchctl_bin)"
        arglist => { "bootstrap", "$(service_launchd_target[$(service_ids)])", "$(launchd_dir)/$(service_ids).plist" },
        contain => tendcf_noshell,
        classes => tendcf_launchd_cmd_clear2(
          "tendcf_svc_launchd_bootstrapped__$(service_canon[$(service_ids)])",
          "tendcf_svc_launchd_bootstrap_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_user_gui_reload_pending__$(service_canon[$(service_ids)])",
          "tendcf_launchd_user_background_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_target_ready__$(service_canon[$(service_ids)]).tendcf_svc_launchd_peer_ready__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_bootstrapped__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_bootstrap_failed__$(service_canon[$(service_ids)]).((!opt_dry_run.tendcf_svc_plist_ready__$(service_canon[$(service_ids)]).!tendcf_svc_plist_failed__$(service_canon[$(service_ids)]).(!tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)])|tendcf_svc_launchd_booted_out__$(service_canon[$(service_ids)])))|(opt_dry_run.((!tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)]).(tendcf_svc_plist_ready__$(service_canon[$(service_ids)])|tendcf_svc_plist_failed__$(service_canon[$(service_ids)])))|(tendcf_svc_launchd_loaded__$(service_canon[$(service_ids)]).(tendcf_svc_plist_failed__$(service_canon[$(service_ids)])|tendcf_launchd_$(service_launchd_reload_key[$(service_ids)])_reload_pending__$(service_canon[$(service_ids)]))))))";

      # 3a/3b. System-mode tombstone probe & teardown (C-policy-04, Adversary #2).
      "$(launchctl_bin)"
        arglist => { "print", "system/$(service_ids)" },
        action => tendcf_probe_always,
        contain => tendcf_noshell_readonly,
        classes => tendcf_launchd_tombstone_probe(
          "tendcf_svc_tombstone_loaded__$(service_canon[$(service_ids)])",
          "tendcf_svc_tombstone_unloaded__$(service_canon[$(service_ids)])",
          "tendcf_svc_tombstone_probe_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_system.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).!tendcf_svc_tombstone_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_tombstone_unloaded__$(service_canon[$(service_ids)]).!tendcf_svc_tombstone_probe_failed__$(service_canon[$(service_ids)])";

      "$(launchctl_bin)"
        arglist => { "bootout", "system/$(service_ids)" },
        contain => tendcf_noshell,
        classes => tendcf_launchd_cmd_clear(
          "tendcf_svc_launchd_torn_down__$(service_canon[$(service_ids)])",
          "tendcf_svc_launchd_teardown_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_system_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_system.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_svc_tombstone_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_tombstone_probe_failed__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_torn_down__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_teardown_failed__$(service_canon[$(service_ids)])";

      # 3c/3d. User-mode tombstone `gui/<uid>` leg (issue #103 Q2 dual sweep).
      "$(launchctl_bin)"
        arglist => { "print", "gui/$(launchd_uid)/$(service_ids)" },
        action => tendcf_probe_always,
        contain => tendcf_noshell_readonly,
        classes => tendcf_launchd_tombstone_probe(
          "tendcf_svc_tomb_gui_loaded__$(service_canon[$(service_ids)])",
          "tendcf_svc_tomb_gui_clear__$(service_canon[$(service_ids)])",
          "tendcf_svc_tomb_gui_probe_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_launchd_gui_available.!tendcf_launchd_gui_probe_failed.!tendcf_launchd_user_probe_failed.(tendcf_launchd_user_available|tendcf_launchd_user_absent).!tendcf_svc_tomb_gui_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_gui_clear__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_gui_probe_failed__$(service_canon[$(service_ids)])";

      "$(launchctl_bin)"
        arglist => { "bootout", "gui/$(launchd_uid)/$(service_ids)" },
        contain => tendcf_noshell,
        classes => tendcf_launchd_cmd_clear(
          "tendcf_svc_tomb_gui_clear__$(service_canon[$(service_ids)])",
          "tendcf_svc_tomb_gui_bootout_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_user_gui_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_svc_tomb_gui_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_gui_clear__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_gui_probe_failed__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_gui_bootout_failed__$(service_canon[$(service_ids)])";

      # 3e/3f. User-mode tombstone `user/<uid>` leg (issue #103 Q2 dual sweep).
      "$(launchctl_bin)"
        arglist => { "print", "user/$(launchd_uid)/$(service_ids)" },
        action => tendcf_probe_always,
        contain => tendcf_noshell_readonly,
        classes => tendcf_launchd_tombstone_probe(
          "tendcf_svc_tomb_user_loaded__$(service_canon[$(service_ids)])",
          "tendcf_svc_tomb_user_clear__$(service_canon[$(service_ids)])",
          "tendcf_svc_tomb_user_probe_failed__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_launchd_user_available.!tendcf_launchd_gui_probe_failed.!tendcf_launchd_user_probe_failed.(tendcf_launchd_gui_available|tendcf_launchd_gui_absent).!tendcf_svc_tomb_user_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_user_clear__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_user_probe_failed__$(service_canon[$(service_ids)])";

      "$(launchctl_bin)"
        arglist => { "bootout", "user/$(launchd_uid)/$(service_ids)" },
        contain => tendcf_noshell,
        classes => tendcf_launchd_cmd_clear(
          "tendcf_svc_tomb_user_clear__$(service_canon[$(service_ids)])",
          "tendcf_svc_tomb_user_bootout_failed__$(service_canon[$(service_ids)])",
          "tendcf_launchd_user_background_reload_pending__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_svc_tomb_user_loaded__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_user_clear__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_user_probe_failed__$(service_canon[$(service_ids)]).!tendcf_svc_tomb_user_bootout_failed__$(service_canon[$(service_ids)])";

      # systemd. The files section ran first in this pass, so a rendered
      # unit is on disk before the manager is told about it.
      "/usr/bin/systemctl"
        arglist => { "daemon-reload" },
        ifvarclass => "tendcf_systemd_reload.!tendcf_cmdb_refused.!tendcf_service_id_collision";

      "/usr/bin/systemctl"
        arglist => { "enable", "$(service_ids)" },
        ifvarclass => "tendcf_svc_systemd_go__$(service_canon[$(service_ids)]).tendcf_svc_enabled__$(service_canon[$(service_ids)]).!tendcf_svc_boot_enabled__$(service_canon[$(service_ids)])";

      "/usr/bin/systemctl"
        arglist => { "disable", "$(service_ids)" },
        ifvarclass => "tendcf_svc_systemd_go__$(service_canon[$(service_ids)]).!tendcf_svc_enabled__$(service_canon[$(service_ids)]).tendcf_svc_boot_enabled__$(service_canon[$(service_ids)])";

      "/usr/bin/systemctl"
        arglist => { "start", "$(service_ids)" },
        ifvarclass => "tendcf_svc_systemd_go__$(service_canon[$(service_ids)]).!tendcf_svc_active__$(service_canon[$(service_ids)])";

      # Changed unit, already running: restart so the new definition runs.
      "/usr/bin/systemctl"
        arglist => { "restart", "$(service_ids)" },
        ifvarclass => "tendcf_svc_systemd_go__$(service_canon[$(service_ids)]).tendcf_svc_active__$(service_canon[$(service_ids)]).tendcf_svc_unit_changed__$(service_canon[$(service_ids)])";

      "/usr/bin/systemctl"
        arglist => { "disable", "--now", "$(service_ids)" },
        classes => tendcf_command_done("tendcf_svc_torn_down__$(service_canon[$(service_ids)])"),
        ifvarclass => "tendcf_svc_teardown__$(service_canon[$(service_ids)])";

      # After a removal. Spelled differently from the first daemon-reload
      # so a run that already reloaded for a render still reloads again.
      "/usr/bin/systemctl"
        arglist => { "--quiet", "daemon-reload" },
        ifvarclass => "tendcf_systemd_unit_removed.!tendcf_cmdb_refused.!tendcf_service_id_collision";

  reports:
      "tendcf_service_id_canon_collision"::
        "tendcf: service actuation refused: two or more service ids collide under canonify(); refusing all service actuation until ids are canonically unique";

      "tendcf_service_id_case_collision"::
        "tendcf: service actuation refused: two or more service ids collide case-insensitively on darwin (APFS); refusing all service actuation until ids are case-insensitively unique";

      "interlock_blocked_$(interlock_bundle_canon[$(interlock_ids)])"::
        "tendcf: interlock '$(interlock_ids)' not satisfied, bundle '$(data:variables.tendcf_interlock[$(interlock_ids)][bundle])' refused";

      "tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_present__$(service_canon[$(service_ids)]).!tendcf_service_id_collision"::
        "tendcf: service '$(service_ids)' refused: installer-owned unit (tendcf-install) cannot be actuated by cfengine";

      "tendcf_svc_reserved__$(service_canon[$(service_ids)]).tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_service_id_collision"::
        "tendcf: service '$(service_ids)' tombstone refused: installer-owned unit (tendcf-install) cannot be removed by cfengine";

      "tendcf_svc_reserved__$(service_canon[$(service_ids)]).!tendcf_svc_present__$(service_canon[$(service_ids)]).!tendcf_svc_absent__$(service_canon[$(service_ids)]).!tendcf_service_id_collision"::
        "tendcf: service '$(service_ids)' refused: installer-owned unit (tendcf-install) cannot be managed by cfengine";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).tendcf_svc_launchd__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)])"::
        "tendcf: launchd service refused: id is not a valid launchd label ([A-Za-z0-9][A-Za-z0-9@._-]*, <=128 chars)";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).tendcf_svc_launchd__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).darwin.!tendcf_launchd_host"::
        "tendcf: service '$(service_ids)' refused: launchd domain/identity invalid, $(launchd_dir) is not a real directory, or $(launchctl_bin) is not executable on this host ($(sys.flavour))";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).tendcf_svc_launchd__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).darwin.tendcf_launchd_host.!tendcf_svc_launchd_domain_valid__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' refused: missing or invalid unit.launchd.domain (expected 'system', 'user-gui', or 'user-background')";

      "tendcf_launchd_mode_system.tendcf_svc_launchd_domain_skipped__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' skipped: belongs to launchd '$(service_launchd_domain[$(service_ids)])' domain (this agent runs 'system')";

      "tendcf_launchd_mode_user.tendcf_svc_launchd_domain_skipped__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' skipped: belongs to launchd 'system' domain (this agent runs 'user-gui' and 'user-background')";

      "tendcf_svc_launchd_deferred__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' deferred: launchd 'gui/$(launchd_uid)' domain is unavailable (no active Aqua GUI login session); user-gui convergence skipped";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).tendcf_svc_launchd__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).darwin.tendcf_launchd_host.tendcf_svc_launchd_domain_match__$(service_canon[$(service_ids)]).tendcf_launchd_mode_system.!tendcf_svc_launchd_run_as_ok__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' refused: system-domain service run_as '$(service_run_as_display[$(service_ids)])' is missing or invalid ([a-z_][a-z0-9_-]*, <=32 chars)";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).tendcf_svc_launchd__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).darwin.tendcf_launchd_host.tendcf_svc_launchd_domain_match__$(service_canon[$(service_ids)]).tendcf_launchd_mode_user.!tendcf_svc_launchd_run_as_ok__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' refused: user-domain service run_as '$(service_run_as_display[$(service_ids)])' does not match running user '$(launchd_run_user)'";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).tendcf_svc_systemd__$(service_canon[$(service_ids)]).!tendcf_svc_systemd_id_valid__$(service_canon[$(service_ids)])"::
        "tendcf: systemd service refused: id is not a valid systemd service unit name ([A-Za-z0-9][A-Za-z0-9@._-]*.service, <=128 chars)";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).!(tendcf_svc_launchd__$(service_canon[$(service_ids)]).!tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)])).!(tendcf_svc_systemd__$(service_canon[$(service_ids)]).!tendcf_svc_systemd_id_valid__$(service_canon[$(service_ids)])).!(tendcf_svc_launchd__$(service_canon[$(service_ids)]).darwin.!tendcf_launchd_host).!(tendcf_svc_launchd__$(service_canon[$(service_ids)]).tendcf_svc_launchd_id_valid__$(service_canon[$(service_ids)]).darwin.tendcf_launchd_host).!(tendcf_svc_systemd__$(service_canon[$(service_ids)]).tendcf_systemd_units_elsewhere)"::
        "tendcf: service '$(service_ids)' refused: unit flavour '$(unit_flavour[$(service_ids)])' is not implemented on this host ($(sys.flavour); adapters: launchd on darwin, systemd on a Linux host booted by systemd)";

      "tendcf_svc_refused__$(service_canon[$(service_ids)]).tendcf_svc_systemd__$(service_canon[$(service_ids)]).tendcf_svc_systemd_id_valid__$(service_canon[$(service_ids)]).tendcf_systemd_units_elsewhere"::
        "tendcf: service '$(service_ids)' refused: /etc/systemd/system is not a writable directory on this host ($(sys.flavour)); its units are written by the system configuration (supervisor nixos), not by cfengine";

      "tendcf_svc_launchd_present_nonregular__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' refused: $(launchd_dir)/$(service_ids).plist is not a regular file (a symlink, dangling link or directory); this adapter writes only a regular plist";

      "tendcf_svc_launchd_present_case_mismatch__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' refused: no exact-case entry '$(service_ids).plist' in $(launchd_dir) (case-insensitive filesystem mismatch); this adapter writes only an exact-case plist";

      "tendcf_launchd_mode_user.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]).tendcf_launchd_gui_probe_failed"::
        "tendcf: service '$(service_ids)' failed: launchctl print gui/$(launchd_uid) exited with unexpected error; user-domain convergence skipped";

      "tendcf_launchd_mode_user.tendcf_svc_launchd_go__$(service_canon[$(service_ids)]).tendcf_launchd_user_probe_failed"::
        "tendcf: service '$(service_ids)' failed: launchctl print user/$(launchd_uid) exited with unexpected error; user-domain convergence skipped";

      "tendcf_svc_launchd_peer_probe_failed__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' failed: launchctl print $(service_launchd_peer[$(service_ids)])/$(service_ids) exited with unexpected error; bootstrap not run";

      "tendcf_svc_launchd_peer_bootout_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' failed: launchctl bootout $(service_launchd_peer[$(service_ids)])/$(service_ids) exited non-zero; bootstrap not run";

      "tendcf_svc_plist_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' failed: could not render or set permissions on $(launchd_dir)/$(service_ids).plist; launchctl not run";

      "tendcf_svc_launchd_bootout_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' failed: launchctl bootout $(service_launchd_target[$(service_ids)])/$(service_ids) exited non-zero; bootstrap not run";

      "tendcf_svc_launchd_bootstrap_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' failed: launchctl bootstrap $(service_launchd_target[$(service_ids)]) $(launchd_dir)/$(service_ids).plist exited non-zero";

      "tendcf_svc_launchd_teardown_refused__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone not actuated: $(launchd_dir)/$(service_ids).plist is not a regular file (a symlink, dangling link or directory); this adapter removes only a file it could have rendered";

      "tendcf_svc_launchd_tombstone_case_mismatch__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone not actuated: no exact-case entry '$(service_ids).plist' in $(launchd_dir) (case-insensitive filesystem mismatch)";

      "tendcf_svc_launchd_tombstone_host_refused__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone not actuated: launchd domain/identity invalid, $(launchd_dir) is not a real directory, or $(launchctl_bin) is not executable on this host ($(sys.flavour))";

      "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_launchd_gui_probe_failed"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl print gui/$(launchd_uid) exited with unexpected error; plist left in place";

      "tendcf_launchd_mode_user.tendcf_svc_launchd_teardown__$(service_canon[$(service_ids)]).tendcf_launchd_user_probe_failed"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl print user/$(launchd_uid) exited with unexpected error; plist left in place";

      "tendcf_svc_tombstone_probe_failed__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl print system/$(service_ids) exited with unexpected error; plist left in place";

      "tendcf_svc_launchd_teardown_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl bootout system/$(service_ids) exited non-zero; plist left in place";

      "tendcf_svc_tomb_gui_probe_failed__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl print gui/$(launchd_uid)/$(service_ids) exited with unexpected error; plist left in place";

      "tendcf_svc_tomb_gui_bootout_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl bootout gui/$(launchd_uid)/$(service_ids) exited non-zero; plist left in place";

      "tendcf_svc_tomb_user_probe_failed__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl print user/$(launchd_uid)/$(service_ids) exited with unexpected error; plist left in place";

      "tendcf_svc_tomb_user_bootout_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' tombstone failed: launchctl bootout user/$(launchd_uid)/$(service_ids) exited non-zero; plist left in place";

      "tendcf_svc_launchd_delete_failed__$(service_canon[$(service_ids)]).!opt_dry_run"::
        "tendcf: service '$(service_ids)' tombstone failed: could not delete $(launchd_dir)/$(service_ids).plist";

      "tendcf_svc_launchd_tombstone_bad_id__$(service_canon[$(service_ids)])"::
        "tendcf: launchd tombstone refused: id is not a valid launchd label ([A-Za-z0-9][A-Za-z0-9@._-]*, <=128 chars)";

      "tendcf_svc_systemd_tombstone_bad_id__$(service_canon[$(service_ids)])"::
        "tendcf: systemd tombstone refused: id is not a valid systemd unit name ([A-Za-z0-9][A-Za-z0-9@._-]*.(service|socket|timer|path), <=128 chars)";

      "tendcf_svc_tombstone_elsewhere__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone not actuated: /etc/systemd/system is not a writable directory on this host ($(sys.flavour)); its units are the system configuration's (supervisor nixos)";

      "tendcf_svc_teardown_refused__$(service_canon[$(service_ids)])"::
        "tendcf: service '$(service_ids)' tombstone not actuated: /etc/systemd/system/$(service_ids) is not a regular file (an alias, mask, dangling link or directory); this adapter removes only a file it could have rendered";
}

body contain tendcf_noshell
{
      useshell     => "noshell";
      exec_timeout => "60";
}

body action tendcf_probe_always
{
      ifelapsed => "0";
}

body contain tendcf_noshell_readonly
{
      useshell     => "noshell";
      exec_timeout => "60";
      preview      => "true";
}

body contain tendcf_interlock_contain(timeout)
{
      # noshell: cf-agent splits the joined pre_action string itself and
      # execv()s it (see the comment on pre_action_cmd). Never "useshell":
      # it would run the joined string through /bin/sh as root.
      useshell     => "noshell";
      exec_timeout => "$(timeout)";
}

body edit_defaults tendcf_no_backup
{
      # The default leaves <unit>.cf-before-edit beside the unit, in the
      # manager's own directory.
      edit_backup => "false";
}

body perms tendcf_plist_perms(owner, group)
{
      mode   => "0644";
      owners => { "$(owner)" };
      groups => { "$(group)" };
      rxdirs => "false";
}

body perms tendcf_user_plist_perms(owner)
{
      mode   => "0644";
      owners => { "$(owner)" };
      rxdirs => "false";
}

body perms tendcf_user_dir_perms(owner)
{
      mode   => "0755";
      owners => { "$(owner)" };
      rxdirs => "false";
}

body perms tendcf_unit_perms
{
      mode => "0644";
      rxdirs => "false";
}

body classes tendcf_plist_rendered(changed_class, ready_class, failed_class)
{
      scope            => "bundle";
      promise_kept     => { "$(ready_class)" };
      promise_repaired => { "$(changed_class)", "$(ready_class)" };
      repair_failed    => { "$(failed_class)" };
      repair_denied    => { "$(failed_class)" };
      repair_timeout   => { "$(failed_class)" };
      cancel_notkept   => { "$(ready_class)" };
}

body classes tendcf_launchd_cmd(ok_class, fail_class)
{
      scope                => "bundle";
      repaired_returncodes => { "0" };
      promise_repaired     => { "$(ok_class)" };
      repair_failed        => { "$(fail_class)" };
      repair_denied        => { "$(fail_class)" };
      repair_timeout       => { "$(fail_class)" };
}

body classes tendcf_launchd_cmd_clear(ok_class, fail_class, clear_class)
{
      scope                => "bundle";
      repaired_returncodes => { "0" };
      promise_repaired     => { "$(ok_class)" };
      cancel_repaired      => { "$(clear_class)" };
      repair_failed        => { "$(fail_class)" };
      repair_denied        => { "$(fail_class)" };
      repair_timeout       => { "$(fail_class)" };
}

body classes tendcf_launchd_cmd_clear2(ok_class, fail_class, clear_class1, clear_class2)
{
      scope                => "bundle";
      repaired_returncodes => { "0" };
      promise_repaired     => { "$(ok_class)" };
      cancel_repaired      => { "$(clear_class1)", "$(clear_class2)" };
      repair_failed        => { "$(fail_class)" };
      repair_denied        => { "$(fail_class)" };
      repair_timeout       => { "$(fail_class)" };
}

body classes tendcf_launchd_gui_domain_probe(avail_class, absent_class, fail_class)
{
      scope                => "bundle";
      kept_returncodes     => { "0" };
      repaired_returncodes => { "125", "112" };
      promise_kept         => { "$(avail_class)" };
      promise_repaired     => { "$(absent_class)" };
      repair_failed        => { "$(fail_class)" };
      repair_denied        => { "$(fail_class)" };
      repair_timeout       => { "$(fail_class)" };
}

body classes tendcf_launchd_user_domain_probe(avail_class, absent_class, fail_class)
{
      scope                => "bundle";
      kept_returncodes     => { "0" };
      repaired_returncodes => { "112" };
      promise_kept         => { "$(avail_class)" };
      promise_repaired     => { "$(absent_class)" };
      repair_failed        => { "$(fail_class)" };
      repair_denied        => { "$(fail_class)" };
      repair_timeout       => { "$(fail_class)" };
}

body classes tendcf_launchd_tombstone_probe(loaded_class, unloaded_class, fail_class)
{
      scope                => "bundle";
      kept_returncodes     => { "0" };
      repaired_returncodes => { "113", "3" };
      promise_kept         => { "$(loaded_class)" };
      promise_repaired     => { "$(unloaded_class)" };
      repair_failed        => { "$(fail_class)" };
      repair_denied        => { "$(fail_class)" };
      repair_timeout       => { "$(fail_class)" };
}

body classes tendcf_launchd_delete(fail_class, clear_class)
{
      scope            => "bundle";
      cancel_repaired  => { "$(clear_class)" };
      repair_failed    => { "$(fail_class)" };
      repair_denied    => { "$(fail_class)" };
      repair_timeout   => { "$(fail_class)" };
}

body classes tendcf_launchd_delete2(fail_class, clear_class1, clear_class2)
{
      scope            => "bundle";
      cancel_repaired  => { "$(clear_class1)", "$(clear_class2)" };
      repair_failed    => { "$(fail_class)" };
      repair_denied    => { "$(fail_class)" };
      repair_timeout   => { "$(fail_class)" };
}

body classes tendcf_unit_rendered(class)
{
      scope             => "namespace";
      promise_repaired  => { "$(class)", "tendcf_systemd_reload" };
}

body classes tendcf_unit_removed
{
      scope             => "namespace";
      promise_repaired  => { "tendcf_systemd_unit_removed" };
}

body classes tendcf_command_done(class)
{
      scope             => "namespace";
      kept_returncodes     => { "0" };
      repaired_returncodes => { "0" };
      promise_kept         => { "$(class)" };
      promise_repaired     => { "$(class)" };
}

body delete tendcf_file_delete
{
      dirlinks => "keep";
      rmdirs   => "false";
}

body delete tendcf_tidy
{
      dirlinks => "delete";
      rmdirs   => "true";
}

body classes tendcf_interlock_result(class, code)
{
      # namespace: the verdict is read by tendcf_services, a later bundle.
      scope                => "namespace";
      kept_returncodes     => { "$(code)" };
      repaired_returncodes => { "$(code)" };
      promise_kept         => { "$(class)" };
      promise_repaired     => { "$(class)" };
}
