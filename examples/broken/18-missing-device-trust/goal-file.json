{
  "schema_version": 3,
  "host": "ed25519:a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
  "domains": {
    "supervision": {
      "coverage": "comprehensive",
      "entries": {
        "service": {
          "com.tendcf.caddy.main": {
            "state": "present",
            "bundle": "caddy",
            "run_as": "caddy",
            "command": [
              "/opt/homebrew/bin/caddy",
              "run",
              "--config",
              "/etc/caddy/Caddyfile"
            ],
            "env": {
              "CADDY_ADMIN_TOKEN": "CADDY_ADMIN_TOKEN"
            },
            "working_dir": "/",
            "unit": {
              "launchd": {
                "run_at_load": true,
                "keep_alive": true
              }
            }
          },
          "com.tendcf.caddy.retired": {
            "state": "absent"
          }
        },
        "interlock": {
          "caddy-config-valid": {
            "state": "present",
            "bundle": "caddy",
            "pre_action": {
              "command": [
                "/opt/homebrew/bin/caddy",
                "validate",
                "--config",
                "/etc/caddy/Caddyfile"
              ],
              "expect_exit": 0,
              "timeout_seconds": 30
            },
            "defines_class": "caddy_config_ok",
            "blocks": "enclosing-bundle",
            "report": true
          }
        },
        "unit-writer": {
          "com.tendcf.caddy.*": {
            "state": "present",
            "writer": "cfengine"
          }
        }
      }
    }
  }
}
