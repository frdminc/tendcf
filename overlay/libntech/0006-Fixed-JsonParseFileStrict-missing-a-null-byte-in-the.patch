From 8a57e5558ef126ccd2f2edf5dd650418fef38724 Mon Sep 17 00:00:00 2001
From: Daniel JB Clark <djbclark@gmail.com>
Date: Sat, 14 Nov 2026 15:49:29 -0500
Subject: [PATCH 6/6] Fixed JsonParseFileStrict() missing a null byte in the
 file

FileRead() builds its Writer with strnlen(), so a null byte cuts the
text off there and the Writer's length still equals the length of the
string that is left: the check that compared the two could never fire,
and a file such as {"vars": {}}<NUL>not-json parsed as the valid
object. The function now reads through FileReadFromFd() and compares the
number of bytes it got with the size fstat() reports for the same
descriptor, so a null byte (or a file that changed while it was read) is
refused with JSON_PARSE_ERROR_INVALID_END.

Found by the unit tests in fork CI (test_parse_file_strict).

Changelog: None
Ticket: none

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 libutils/json.c | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/libutils/json.c b/libutils/json.c
index 9a4b4f3..513dbdd 100644
--- a/libutils/json.c
+++ b/libutils/json.c
@@ -3076,8 +3076,17 @@ JsonParseError JsonParseFileStrict(
     assert(json_out != NULL);
     *json_out = NULL;
 
+    const int fd = safe_open(path, O_RDONLY);
+    if (fd == -1)
+    {
+        return JSON_PARSE_ERROR_NO_SUCH_FILE;
+    }
+
     bool truncated = false;
-    Writer *contents = FileRead(path, size_max, &truncated);
+    Writer *const contents = FileReadFromFd(fd, size_max, &truncated);
+    struct stat sb;
+    const bool have_size = (fstat(fd, &sb) == 0);
+    close(fd);
     if (contents == NULL)
     {
         return JSON_PARSE_ERROR_NO_SUCH_FILE;
@@ -3090,10 +3099,12 @@ JsonParseError JsonParseFileStrict(
 
     const char *data = StringWriterData(contents);
     JsonParseError error;
-    if (strlen(data) != StringWriterLength(contents))
+    if (!have_size || (size_t) sb.st_size != StringWriterLength(contents))
     {
-        /* A null byte would end the string early and hide the rest of
-         * the file from the parser. */
+        /* The Writer is a C string: a null byte ends it early and hides
+         * the rest of the file from the parser, so fewer bytes arrive than
+         * the file holds. A file that changed while it was read is refused
+         * too. */
         error = JSON_PARSE_ERROR_INVALID_END;
     }
     else
