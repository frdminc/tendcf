From 78ec200227627808b2db8367cc6046bcd26de6ba Mon Sep 17 00:00:00 2001
From: Daniel JB Clark <djbclark@gmail.com>
Date: Wed, 25 Nov 2026 23:21:26 -0500
Subject: [PATCH] Fixed JsonParseAsString() reading past NUL on a trailing
 backslash

When a JSON string ended with an unescaped backslash at the end of input,
JsonParseAsString() fell through into WriterWriteChar(writer, **data) on
the NUL byte and the enclosing loop advanced *data past the terminator.
Return JSON_PARSE_ERROR_STRING_NO_DOUBLEQUOTE_END immediately when the
character after backslash is NUL, and destroy the array on string-parse
failure in JsonParseAsArray() so error paths do not leak.

Changelog: Title
Ticket: none

diff --git a/libutils/json.c b/libutils/json.c
index e46e0716629a4e6ff54d6166e2d466c3bc332cf5..cf00e691de79ea0716147ae273cdbf7433b846a6 100644
--- a/libutils/json.c
+++ b/libutils/json.c
@@ -2208,6 +2208,12 @@ static JsonParseError JsonParseAsString(
 
         case '\\':
             *data = *data + 1;
+            if (**data == '\0')
+            {
+                WriterClose(writer);
+                *str_out = NULL;
+                return JSON_PARSE_ERROR_STRING_NO_DOUBLEQUOTE_END;
+            }
             switch (**data)
             {
             case '\\':
@@ -2471,6 +2477,8 @@ static JsonParseError JsonParseAsArray(
             JsonParseError err = JsonParseAsString(data, &value);
             if (err != JSON_PARSE_OK)
             {
+                *json_out = NULL;
+                JsonDestroy(array);
                 return err;
             }
             JsonArrayAppendElement(
diff --git a/tests/unit/json_test.c b/tests/unit/json_test.c
index 200478a85ac52ac8aba35752c531c35a289b8f98..5efceeb91934bd231b9159330c7b813c8ae5ff22 100644
--- a/tests/unit/json_test.c
+++ b/tests/unit/json_test.c
@@ -2487,6 +2487,43 @@ static void test_json_parse_object_missing_comma(void)
     }
 }
 
+static void test_parse_string_trailing_backslash(void)
+{
+    /* Exact-sized heap buffers so ASan catches any read past the NUL. */
+    const char *const cases[] = {
+        "\"x\\",
+        "\"\\",
+        "{\"a\": \"x\\",
+        "{\"x\\",
+        "[\"x\\",
+        NULL
+    };
+
+    for (size_t i = 0; cases[i] != NULL; i++)
+    {
+        const size_t len = strlen(cases[i]);
+        char *buf = xmalloc(len + 1);
+        memcpy(buf, cases[i], len + 1);
+
+        const char *data = buf;
+        JsonElement *json = NULL;
+        assert_int_equal(
+            JSON_PARSE_ERROR_STRING_NO_DOUBLEQUOTE_END,
+            JsonParse(&data, &json));
+        assert_true(json == NULL);
+
+        free(buf);
+    }
+
+    /* Escaped trailing backslash before the closing quote still parses. */
+    const char *valid = "\"x\\\\\"";
+    JsonElement *json = NULL;
+    assert_int_equal(JSON_PARSE_OK, JsonParse(&valid, &json));
+    assert_true(json != NULL);
+    assert_string_equal("x\\", JsonPrimitiveGetAsString(json));
+    JsonDestroy(json);
+}
+
 int main()
 {
     PRINT_TEST_BANNER();
@@ -2560,6 +2597,7 @@ int main()
         unit_test(test_compare_container_type_mismatch),
         unit_test(test_json_get_type_as_string),
         unit_test(test_json_parse_object_missing_comma),
+        unit_test(test_parse_string_trailing_backslash),
     };
 
     return run_tests(tests);
