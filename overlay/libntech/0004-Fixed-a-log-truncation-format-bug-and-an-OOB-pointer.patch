From 2f584b09184f92ccf56b7d5dc8f6262bb6b4ebea Mon Sep 17 00:00:00 2001
From: Daniel JB Clark <djbclark@gmail.com>
Date: Tue, 18 Aug 2026 18:49:40 -0400
Subject: [PATCH 4/4] Fixed a log-truncation format bug and an OOB pointer
 construction

Both found while writing unit tests for MustacheRender().

mustache.c:284,297 used %20s (minimum width) where %.20s (truncate)
was intended, per the trailing "..." in both messages: short strings
got left-padded instead, long ones dumped the whole remaining
template into the log.

IsTagStandalone() formed tag_start - 1 when a non-renderable tag (a
#section or comment) starts at offset 0 -- exercised by the existing
"{{#b}}yes{{/b}}" test case -- pointing one before the input buffer.
The loop condition never dereferences it, so no failure mode is
observed under UBSan pointer-overflow or ASan, but constructing an
out-of-bounds pointer is undefined behavior regardless.

Verified: full unit suite (40 binaries) passes; mustache_test 17/17
under both default flags and -fsanitize=undefined,pointer-overflow.

Changelog: Title
Ticket: CFE-4740

diff --git a/libutils/mustache.c b/libutils/mustache.c
index 580834f81db77b953118a8f4b1336d4d2abda448..b547d0ed23d4fbe20ab8cb28820bb9254ced1da0 100644
--- a/libutils/mustache.c
+++ b/libutils/mustache.c
@@ -71,25 +71,32 @@ static bool IsTagStandalone(const char *start, const char *tag_start, const char
     assert(start <= tag_start);
 
     *line_begin = start;
-    for (const char *cur = tag_start - 1; cur >= start; cur--)
+    // tag_start == start has no preceding character to scan; forming
+    // tag_start - 1 in that case would point before the buffer, which the
+    // loop below never would have dereferenced but is undefined behaviour
+    // to construct at all.
+    if (tag_start != start)
     {
-        if (IsSpace(*cur))
+        for (const char *cur = tag_start - 1; cur >= start; cur--)
         {
-            *line_begin = cur;
-            if (cur == start)
+            if (IsSpace(*cur))
+            {
+                *line_begin = cur;
+                if (cur == start)
+                {
+                    break;
+                }
+                continue;
+            }
+            else if (*cur == '\n')
             {
+                *line_begin = cur + 1;
                 break;
             }
-            continue;
-        }
-        else if (*cur == '\n')
-        {
-            *line_begin = cur + 1;
-            break;
-        }
-        else
-        {
-            return false;
+            else
+            {
+                return false;
+            }
         }
     }
 
@@ -274,7 +281,7 @@ static Mustache NextTag(const char *input,
         const char *escape_end = strstr(ret.content, extra_end);
         if (!escape_end || strncmp(escape_end + 1, delim_end, delim_end_len) != 0)
         {
-            Log(LOG_LEVEL_ERR, "Broken mustache template, couldn't find end tag for quoted begin tag at '%20s'...", input);
+            Log(LOG_LEVEL_ERR, "Broken mustache template, couldn't find end tag for quoted begin tag at '%.20s'...", input);
             ret.type = TAG_TYPE_ERR;
             return ret;
         }
@@ -287,7 +294,7 @@ static Mustache NextTag(const char *input,
         ret.end = strstr(ret.content, delim_end);
         if (!ret.end)
         {
-            Log(LOG_LEVEL_ERR, "Broken Mustache template, could not find end delimiter after reading start delimiter at '%20s'...", input);
+            Log(LOG_LEVEL_ERR, "Broken Mustache template, could not find end delimiter after reading start delimiter at '%.20s'...", input);
             ret.type = TAG_TYPE_ERR;
             return ret;
         }
