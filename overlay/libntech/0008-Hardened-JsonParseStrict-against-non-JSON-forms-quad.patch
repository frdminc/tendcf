+    }
+    for (size_t i = 0; i < max_depth; i++)
+    {
+        WriterWriteChar(w, '}');
+    }
+    char *too_deep_obj = StringWriterClose(w);
+    assert_strict_refused(too_deep_obj, JSON_PARSE_ERROR_MAX_DEPTH);
+    free(too_deep_obj);
