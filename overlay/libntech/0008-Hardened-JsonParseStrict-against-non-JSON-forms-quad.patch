+    {
+        WriterWriteChar(w, '[');
+    }
+    for (size_t i = 0; i < max_depth; i++)
+    {
+        WriterWriteChar(w, ']');
+    }
+    char *ok_arr = StringWriterClose(w);
+
+    const char *data = ok_arr;
+    JsonElement *json = NULL;
+    assert_int_equal(JSON_PARSE_OK, JsonParseStrict(&data, &json));
+    assert_true(json != NULL);
+    JsonDestroy(json);
+    free(ok_arr);
