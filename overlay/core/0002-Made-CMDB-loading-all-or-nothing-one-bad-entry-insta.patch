+static void test_section_of_wrong_type_installs_nothing(void)
+{
+    WriteCMDBFile(
+        "{\n"
+        "  \"vars\": { \"good_var\": \"x\" },\n"
+        "  \"classes\": [ \"any::\" ]\n"
+        "}\n");
+
+    EvalContext *ctx = EvalContextNew();
+    assert_false(LoadCMDBData(ctx));
+
+    assert_false(VariableIsInstalled(ctx, "data:variables.good_var"));
+
