+static void test_bad_metadata_installs_nothing(void)
+{
+    /* Malformed tags make the entry invalid, not just tag-less. */
+    WriteCMDBFile(
+        "{\n"
+        "  \"vars\": { \"good_var\": \"x\" },\n"
