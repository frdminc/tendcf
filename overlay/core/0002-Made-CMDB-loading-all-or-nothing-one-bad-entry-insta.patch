+                                StringSet *tags, const char *comment)
+{
+    CMDBPendingClass *cls = xmalloc(sizeof(*cls));
+    *cls = (CMDBPendingClass) { .key = key, .tags = tags, .comment = comment };
+    SeqAppend(pending->classes, cls);
+}
