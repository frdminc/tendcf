From 70670fc045f578548bde57f25c0b701fbeb030ab Mon Sep 17 00:00:00 2001
From: Daniel JB Clark <djbclark@gmail.com>
Date: Wed, 25 Nov 2026 23:21:28 -0500
Subject: [PATCH] Refused unknown keys inside CMDB class and variable metadata
 objects

LoadCMDBData() already rejected unknown top-level keys so a typo cannot
silently drop an entry, but PrepareCMDBClasses() and PrepareCMDBVariables()
ignored unknown member names inside metadata objects (for example a
misspelled class_expression or tag). Reject any member outside the
allowed metadata keys and install nothing from the file.

Changelog: Title
Ticket: none

diff --git a/libpromises/cmdb.c b/libpromises/cmdb.c
index b0c42a50e38071b01a0fe7c96256e3f3dcb270d2..4bb26a4f41b809ae733cbca6d77aefda33f7470d 100644
--- a/libpromises/cmdb.c
+++ b/libpromises/cmdb.c
@@ -690,6 +690,32 @@ static inline const char *GetCMDBComment(const char *item_type, const char *iden
     return JsonPrimitiveGetAsString(json_comment);
 }
 
+static bool CheckCMDBMetadataKeys(const JsonElement *obj,
+                                  const char *item_type,
+                                  const char *identifier,
+                                  const char *const allowed_keys[],
+                                  const char *allowed_desc)
+{
+    assert(obj != NULL);
+    assert(JsonGetType(obj) == JSON_TYPE_OBJECT);
+
+    bool valid = true;
+    JsonIterator meta_iter = JsonIteratorInit(obj);
+    while (JsonIteratorHasMore(&meta_iter))
+    {
+        const char *meta_key = JsonIteratorNextKey(&meta_iter);
+        if (!IsStrIn(meta_key, allowed_keys))
+        {
+            Log(LOG_LEVEL_ERR,
+                "Invalid key '%s' in CMDB %s specification '%s'"
+                " (only %s are allowed)",
+                meta_key, item_type, identifier, allowed_desc);
+            valid = false;
+        }
+    }
+    return valid;
+}
+
 /**
  * Validate the 'variables' section, which uses the new format allowing
  * metadata (CFE-3633). Same contract as PrepareCMDBVars().
@@ -734,6 +760,19 @@ static bool PrepareCMDBVariables(JsonElement *variables, const char *file_path,
 
         if (JsonGetType(var_info) == JSON_TYPE_OBJECT)
         {
+            const char *const allowed_var_keys[] = {
+                CMDB_VARIABLES_DATA,
+                CMDB_VARIABLES_TAGS,
+                CMDB_COMMENT_KEY,
+                NULL
+            };
+            if (!CheckCMDBMetadataKeys(var_info, "variable", key,
+                                       allowed_var_keys,
+                                       "'value', 'tags' and 'comment'"))
+            {
+                entry_valid = false;
+            }
+
             data = JsonObjectGet(var_info, CMDB_VARIABLES_DATA);
 
             if (data == NULL)
@@ -945,6 +984,21 @@ static bool PrepareCMDBClasses(JsonElement *classes, const char *file_path,
         }
         else if (JsonGetContainerType(data) == JSON_CONTAINER_TYPE_OBJECT)
         {
+            bool entry_valid = true;
+            const char *const allowed_class_keys[] = {
+                CMDB_CLASSES_CLASS_EXPRESSIONS,
+                CMDB_CLASSES_REGULAR_EXPRESSIONS,
+                CMDB_CLASSES_TAGS,
+                CMDB_COMMENT_KEY,
+                NULL
+            };
+            if (!CheckCMDBMetadataKeys(
+                    data, "class", key, allowed_class_keys,
+                    "'class_expressions', 'regular_expressions', 'tags' and 'comment'"))
+            {
+                entry_valid = false;
+            }
+
             const JsonElement *class_exprs = JsonObjectGet(data, CMDB_CLASSES_CLASS_EXPRESSIONS);
             const JsonElement *reg_exprs = JsonObjectGet(data, CMDB_CLASSES_REGULAR_EXPRESSIONS);
             const JsonElement *json_tags = JsonObjectGet(data, CMDB_CLASSES_TAGS);
@@ -968,7 +1022,6 @@ static bool PrepareCMDBClasses(JsonElement *classes, const char *file_path,
                 continue;
             }
 
-            bool entry_valid = true;
             tags = GetTagsFromJsonTags("class", key, json_tags, CMDB_SOURCE_TAG, &entry_valid);
             comment = GetCMDBComment("class", key, data, &entry_valid);
             if (!entry_valid)
diff --git a/tests/unit/cmdb_test.c b/tests/unit/cmdb_test.c
index 8d2d02853b1486e58f2ba6a40abb24364fa1de68..d1d43c902d1d869d4014dc42f25bb2a5cff1cafd 100644
--- a/tests/unit/cmdb_test.c
+++ b/tests/unit/cmdb_test.c
@@ -738,6 +738,57 @@ static void test_whitespace_after_document_is_fine(void)
     RemoveCMDBFile();
 }
 
+static void test_unknown_metadata_key_installs_nothing(void)
+{
+    /* Unknown keys inside 'classes' or 'variables' metadata objects (such as
+     * a misspelled 'class_expression' or 'tag') must fail the whole file,
+     * installing nothing. */
+    const char *const absent[] = {
+        "data:variables.good_var", "data:variables.x", NULL
+    };
+    const char *const absent_class[] = { "good_class", "maint", NULL };
+    const char *const files[] = {
+        /* misspelled 'class_expression' (singular) */
+        "{ \"vars\": { \"good_var\": \"x\" },\n"
+        "  \"classes\": { \"good_class\": \"any::\",\n"
+        "                 \"maint\": { \"class_expression\": [\"!prod::\"] } } }\n",
+        /* misspelled 'tag' (singular) in variables */
+        "{ \"vars\": { \"good_var\": \"x\" },\n"
+        "  \"variables\": { \"x\": { \"value\": \"1\", \"tag\": [\"t1\"] } },\n"
+        "  \"classes\": { \"good_class\": \"any::\" } }\n",
+        /* extra unknown key alongside valid class metadata */
+        "{ \"vars\": { \"good_var\": \"x\" },\n"
+        "  \"classes\": { \"good_class\": \"any::\",\n"
+        "                 \"maint\": { \"class_expressions\": [\"any::\"],\n"
+        "                              \"unknown\": true } } }\n",
+        /* extra unknown key alongside valid variable metadata */
+        "{ \"vars\": { \"good_var\": \"x\" },\n"
+        "  \"variables\": { \"x\": { \"value\": \"1\", \"unknown\": true } },\n"
+        "  \"classes\": { \"good_class\": \"any::\" } }\n",
+        NULL
+    };
+
+    for (size_t i = 0; files[i] != NULL; i++)
+    {
+        assert_rejected_and_nothing_installed(files[i], absent, absent_class);
+    }
+
+    /* Positive control: all valid metadata keys still load cleanly. */
+    WriteCMDBFile(
+        "{ \"variables\": { \"x\": { \"value\": \"1\", \"tags\": [\"t1\"],"
+        "                            \"comment\": \"ok\" } },\n"
+        "  \"classes\": { \"maint\": { \"class_expressions\": [\"any::\"],"
+        "                              \"regular_expressions\": [\"any\"],"
+        "                              \"tags\": [\"t2\"],"
+        "                              \"comment\": \"ok\" } } }\n");
+    EvalContext *ctx = EvalContextNew();
+    assert_true(LoadCMDBData(ctx));
+    assert_string_equal(InstalledScalar(ctx, "data:variables.x"), "1");
+    assert_true(ClassIsInstalled(ctx, "maint"));
+    EvalContextDestroy(ctx);
+    RemoveCMDBFile();
+}
+
 int main()
 {
     PRINT_TEST_BANNER();
@@ -769,6 +820,7 @@ int main()
         unit_test(test_failed_class_insertion_rolls_back_everything),
         unit_test(test_repeated_member_or_trailing_input_installs_nothing),
         unit_test(test_whitespace_after_document_is_fine),
+        unit_test(test_unknown_metadata_key_installs_nothing),
     };
 
     int ret = run_tests(tests);
